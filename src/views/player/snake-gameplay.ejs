<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Snake & Ladders — Live Match Arena</title>
  <meta name="description" content="Play Snake & Ladders live real-money battle. Climb ladders, avoid snakes, and race to 100!">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="snake-gameplay.css">
</head>
<body class="snake-arena-body">

  <div class="gameplay-screen-wrapper">
    <!-- Ambient Background Pattern -->
    <div class="gameplay-bg-pattern"></div>

    <!-- 1. TOP HEADER RESOURCE BAR -->
    <header class="top-header-bar">
      <!-- Menu Button -->
      <button class="btn-menu-dark" onclick="window.location.href='snake-ladders.html'" aria-label="Lobby">
        <span class="line"></span>
        <span class="line"></span>
        <span class="line"></span>
      </button>

      <!-- Coins Pill -->
      <div class="res-pill-gold" onclick="alert('Balance: ₹25,350')" title="Balance">
        <img class="res-icon-img" src="assets/chip.svg" alt="Chips">
        <span class="res-value-text" id="header-chips-val">25,350</span>
        <span class="res-btn-plus">+</span>
      </div>

      <!-- Gems Pill -->
      <div class="res-pill-cyan" onclick="alert('Diamonds: 1,250')" title="Diamonds">
        <img class="res-icon-img" src="assets/diamond.svg" alt="Gems">
        <span class="res-value-text" id="header-gems-val">1,250</span>
        <span class="res-btn-plus">+</span>
      </div>

      <!-- Notification Bell -->
      <button class="btn-bell-dark" onclick="alert('No new alerts')" aria-label="Alerts">
        <img class="res-icon-img" src="assets/bell.svg" alt="Bell">
        <span class="badge-dot">3</span>
      </button>
    </header>

    <!-- 2. TOP CONTROLS & OPPONENT PLAYER CARD ROW -->
    <div class="controls-top-row">
      <!-- Gold Back Button -->
      <button class="btn-undo-gold" onclick="window.location.href='snake-ladders.html'" title="Back to Lobby">
        ↩
      </button>

      <!-- Mode / Match Specs Tag -->
      <div class="match-mode-pill">
        <span>🎲</span>
        <span id="match-mode-text">RACE TO 100</span>
      </div>

      <!-- Opponent Player Card (Top-Right) -->
      <div class="player-game-card" id="player-card-bot">
        <div class="player-avatar-box">
          <img src="assets/avatar_amit.png" alt="Bot">
        </div>
        <div class="player-info-meta">
          <span class="player-name-lbl">Bot</span>
          <span class="player-tag-id">BOT_2088</span>
          <div class="player-score-row">
            <span>Score: </span>
            <strong class="score-val" id="score-val-bot">0</strong>
          </div>
        </div>
        <!-- 3D Dice Box -->
        <div class="dice-gif-box" id="dice-box-bot">
          <img id="dice-img-green" src="assets/dice_1.png" alt="Dice">
        </div>
      </div>
    </div>

    <!-- 3. CENTRAL 10x10 SNAKE & LADDERS BOARD -->
    <div class="snake-board-outer-frame">
      <div class="snake-board-wrapper" id="snake-board-wrapper">
        <!-- Tokens are dynamically positioned here via snake-engine.js -->
      </div>
    </div>

    <!-- 4. BOTTOM CONTROLS & USER PLAYER CARD ROW -->
    <div class="controls-bottom-row">
      <!-- User Player Card (Bottom-Left) -->
      <div class="player-game-card active-turn" id="player-card-you">
        <div class="player-avatar-box">
          <img src="assets/avatar_rahul.png" alt="You">
        </div>
        <div class="player-info-meta">
          <span class="player-name-lbl">You</span>
          <span class="player-tag-id">YOU_1045</span>
          <div class="player-score-row">
            <span>Score: </span>
            <strong class="score-val" id="score-val-you">0</strong>
          </div>
        </div>
        <!-- 3D Dice Box (Clickable for Player Roll) -->
        <div class="dice-gif-box" id="dice-box-you" onclick="handlePlayerDiceRoll()">
          <img id="dice-img-blue" src="assets/dice_1.png" alt="Dice">
        </div>
      </div>

      <!-- Spectators / Live Stakes Pill -->
      <div class="live-stakes-pill">
        <span class="stakes-title">PRIZE POOL</span>
        <span class="stakes-amount">₹36</span>
      </div>
    </div>

    <!-- 5. TURN TIMER BAR -->
    <div class="turn-timer-container">
      <div class="turn-timer-bar" id="turn-timer-bar"></div>
    </div>

  </div>

  <!-- GRAND VICTORY / MATCH OVER CELEBRATION MODAL (JASHAN SCREEN) -->
  <div class="modal-victory-backdrop" id="modal-game-victory">
    <canvas id="confetti-canvas" class="confetti-canvas"></canvas>
    <div class="modal-victory-box">
      <!-- Glow rays -->
      <div class="victory-sunburst-glow"></div>
      
      <div class="victory-trophy-icon" id="celebration-icon">🏆</div>
      <h2 class="victory-title-text" id="victory-title">VICTORY!</h2>
      <p class="victory-sub-text" id="victory-sub">Match Over! 1st player reached Square 100.</p>

      <!-- Winner & Loser Duel Summary -->
      <div class="match-duel-summary-box">
        <!-- Winner Card -->
        <div class="duel-result-card winner-card">
          <div class="result-rank-crown">👑 1st Rank</div>
          <div class="result-player-row">
            <img class="result-avatar-img" id="winner-avatar" src="assets/avatar_rahul.png" alt="Winner">
            <div class="result-player-info">
              <span class="result-name" id="winner-name">You</span>
              <span class="result-score-lbl" id="winner-score-info">Square 100 • Score 100</span>
            </div>
            <div class="result-prize-pill winner-prize" id="winner-prize-tag">+₹36 WON</div>
          </div>
        </div>

        <!-- Loser Card -->
        <div class="duel-result-card loser-card">
          <div class="result-rank-crown runner-up">🥈 2nd Rank</div>
          <div class="result-player-row">
            <img class="result-avatar-img" id="loser-avatar" src="assets/avatar_amit.png" alt="Runner Up">
            <div class="result-player-info">
              <span class="result-name" id="loser-name">Bot</span>
              <span class="result-score-lbl" id="loser-score-info">Square 49 • Score 49</span>
            </div>
            <div class="result-prize-pill loser-prize">-₹20</div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="victory-actions-single">
        <button class="btn-return-lobby" onclick="window.location.href='snake-ladders.html'">
          RETURN TO LOBBY
        </button>
      </div>
    </div>
  </div>

  <!-- Sound & Engine Scripts -->
  <script src="snake-engine.js"></script>
</body>
</html>
