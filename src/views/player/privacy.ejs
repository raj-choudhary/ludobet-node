<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Privacy Policy | Ludo Tournament King</title>
  <meta name="description" content="Privacy policy, data encryption, and personal data protection for Ludo Tournament King players.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="rules.css">
</head>
<body>
  <div class="app-container">
    
    <!-- 1. TOP HEADER (Menu + Resource Pill) -->
    <header class="top-header">
      <button class="btn-menu" id="btn-menu" aria-label="Menu" onclick="window.location.href='index.html'">
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>

      <div class="resource-pill">
        <a href="wallet.html" class="res-item" style="text-decoration:none;" aria-label="Wallet Balance">
          <img class="res-icon" src="assets/chip.svg" alt="Chips">
          <div class="res-data">
            <span class="res-amount" id="chips-value">₹1,250</span>
            <span class="res-label">Cash</span>
          </div>
          <span class="btn-plus">+</span>
        </a>

        <div class="res-item" aria-label="Gems">
          <img class="res-icon" src="assets/diamond.svg" alt="Gems">
          <div class="res-data">
            <span class="res-amount" id="earnings-value">20</span>
            <span class="res-label">Gems</span>
          </div>
        </div>

        <button class="bell-item" onclick="window.location.href='notifications.html'" aria-label="Notifications">
          <div class="bell-icon-wrapper">
            <img class="bell-icon" src="assets/bell.svg" alt="Bell">
            <span class="bell-badge">3</span>
          </div>
        </button>
      </div>
    </header>

    <!-- Sub-Header Bar -->
    <div class="sub-header-bar">
      <button class="btn-back" onclick="window.location.href='index.html'" aria-label="Go Back">←</button>
      <div class="page-title-group">
        <h1 class="rules-page-title">
          <span class="title-green">PRIVACY</span> <span class="title-blue">POLICY</span>
        </h1>
        <span class="page-subtitle">Data Protection &amp; Security Standards</span>
      </div>
      <div class="status-verified-badge" style="background:#dcfce7; color:#15803d; border-color:#86efac;">
        🔒 SECURE
      </div>
    </div>

    <!-- MAIN BODY -->
    <main class="rules-main-body">
      <div class="rule-card">
        <div class="rule-card-header">
          <span class="rule-h-icon">🔒</span>
          <span class="rule-h-title">User Privacy &amp; Data Security</span>
        </div>
        <ul class="rule-bullet-list">
          <li><strong>1. Information Collected:</strong> We collect mobile numbers, full names, profile avatars, and Aadhaar/PAN details solely for KYC authentication and instant bank payouts.</li>
          <li><strong>2. 256-Bit SSL Encryption:</strong> All payment transactions and personal credentials are encrypted using bank-grade 256-bit SSL protocols.</li>
          <li><strong>3. No Third-Party Sharing:</strong> We do not sell, rent, or trade your personal information with any third-party advertisers.</li>
          <li><strong>4. Account Data Rights:</strong> Users can request account data deletion or export by contacting our support team at <em>support@ludotournamentking.com</em>.</li>
        </ul>
      </div>

      <div class="rules-bottom-cta">
        <button class="btn-play-now" onclick="window.location.href='terms.html'">
          📜 VIEW TERMS &amp; CONDITIONS ›
        </button>
      </div>
    </main>

    <!-- Bottom Navigation -->
    <div class="bottom-nav-container">
      <nav class="bottom-nav">
        <button class="nav-tab" onclick="window.location.href='index.html'">
          <img class="nav-icon-svg" src="assets/home.svg" alt="Home">
          <span class="nav-label">Home</span>
        </button>
        <button class="nav-tab" onclick="window.location.href='ludo-classic.html'">
          <img class="nav-icon-svg" src="assets/chip.svg" alt="Battles">
          <span class="nav-label">Battles</span>
        </button>
        <button class="nav-tab" onclick="window.location.href='ranking.html'">
          <img class="nav-icon-svg" src="assets/ranking.svg" alt="Leaderboard">
          <span class="nav-label">Ranking</span>
        </button>
        <button class="nav-tab" onclick="window.location.href='wallet.html'">
          <img class="nav-icon-svg" src="assets/wallet.svg" alt="Wallet">
          <span class="nav-label">Wallet</span>
        </button>
        <button class="nav-tab active" onclick="window.location.href='profile.html'">
          <img class="nav-icon-svg" src="assets/profile.svg" alt="Profile">
          <span class="nav-label">Profile</span>
        </button>
      </nav>
      <div class="home-indicator"></div>
    </div>
  </div>
</body>
</html>
