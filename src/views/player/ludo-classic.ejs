<link rel="stylesheet" href="/css/classic-battle.css">

<!-- 2. SUB-HEADER WITH BACK BUTTON & TITLE -->
<div class="sub-header-bar">
  <button class="btn-back" onclick="window.location.href='/'" aria-label="Back to Home">
    ←
  </button>
  <div class="page-title-group">
    <div class="ludo-classic-title">
      <span class="title-l">L</span><span class="title-u">U</span><span class="title-d">D</span><span class="title-o">O</span>
      <span class="title-classic">CLASSIC</span>
    </div>
    <div class="page-subtitle">Create a battle or join a battle</div>
  </div>
</div>

<!-- 3. "CREATE BATTLE" MAIN CARD -->
<section class="create-battle-card">
  <div class="create-battle-badge">CREATE BATTLE</div>
  
  <!-- 3D Board Artwork -->
  <img class="create-battle-art-img" src="/assets/board_3d_card.png" alt="3D Ludo Board">
  
  <div class="entry-amount-label">Entry Amount (₹)</div>
  
  <div class="amount-input-wrapper">
    <span class="currency-symbol">₹</span>
    <input type="number" class="amount-input" id="create-entry-amount" value="50" min="10" max="10000" step="10">
  </div>

  <!-- Preset Quick Chips -->
  <div class="amount-presets">
    <button class="preset-chip-btn" onclick="setPresetAmount(10, this)">₹10</button>
    <button class="preset-chip-btn" onclick="setPresetAmount(20, this)">₹20</button>
    <button class="preset-chip-btn active" onclick="setPresetAmount(50, this)">₹50</button>
    <button class="preset-chip-btn" onclick="setPresetAmount(100, this)">₹100</button>
    <button class="preset-chip-btn" onclick="setPresetAmount(200, this)">₹200</button>
  </div>

  <button class="btn-create-battle" onclick="executeCreateBattleFlow()">CREATE BATTLE</button>
</section>

<!-- 4. REDESIGNED JOIN PRIVATE BATTLE -->
<div class="private-battle-container">
  <div class="private-battle-card" onclick="alert('Enter 6-digit Room Code to join private battle.')">
    <div class="private-icon-box">
      <span class="private-lock-icon">🔒</span>
    </div>

    <div class="private-card-info">
      <div class="private-card-title">JOIN PRIVATE BATTLE</div>
      <div class="private-card-sub">Enter Room Code and join your private battle</div>
    </div>

    <div class="private-actions-group">
      <button class="btn-how-it-works-animated" onclick="event.stopPropagation(); alert('Ludo Classic 1v1 Rules: Traditional 52-cell board, 4 pawns each, 15-second turn timer.');" title="How it works & Rules">
        <span class="info-icon-symbol">ℹ</span>
        <span class="info-icon-label">Rules</span>
      </button>
      <div class="private-card-arrow">➔</div>
    </div>
  </div>
</div>

<!-- 5. BATTLE LIST TABS -->
<div class="battle-tabs-container">
  <button class="battle-tab-btn active" id="tab-open-battles">
    OPEN BATTLES (<%= openBattles.length %>)
  </button>
  <button class="battle-tab-btn" id="tab-running-battles">
    RUNNING BATTLES <span class="badge-live-pulse">● LIVE</span>
  </button>
</div>

<!-- 7. OPEN BATTLES LIST CONTAINER -->
<div class="battles-list" id="battles-list-container">
  <% if (openBattles && openBattles.length > 0) { %>
    <% openBattles.forEach(function(b) { %>
      <div class="battle-card-item">
        <div class="bci-player">
          <div class="bci-avatar">👑</div>
          <div class="bci-meta">
            <strong class="bci-name"><%= b.creator_name %></strong>
            <span class="bci-mode">1v1 CLASSIC</span>
          </div>
        </div>
        <div class="bci-pricing">
          <span class="bci-fee">Entry: ₹<%= parseFloat(b.entry_fee).toFixed(0) %></span>
          <strong class="bci-prize">Win: ₹<%= parseFloat(b.prize_pool).toFixed(0) %></strong>
        </div>
        <button class="btn-accept-battle" onclick="joinMatchAction(<%= b.id %>)">
          ACCEPT
        </button>
      </div>
    <% }); %>
  <% } else { %>
    <div class="battle-card-item">
      <div class="bci-player">
        <div class="bci-avatar" style="background:#eab308;">👤</div>
        <div class="bci-meta">
          <strong class="bci-name">Rahul_Gamer</strong>
          <span class="bci-mode">1v1 CLASSIC</span>
        </div>
      </div>
      <div class="bci-pricing">
        <span class="bci-fee">Entry: ₹50</span>
        <strong class="bci-prize">Win: ₹95</strong>
      </div>
      <button class="btn-accept-battle" onclick="alert('Joining 1v1 Battle...')">
        ACCEPT
      </button>
    </div>
  <% } %>
</div>

<script>
  function setPresetAmount(amt, elem) {
    document.getElementById('create-entry-amount').value = amt;
    document.querySelectorAll('.preset-chip-btn').forEach(b => b.classList.remove('active'));
    if (elem) elem.classList.add('active');
  }

  async function executeCreateBattleFlow() {
    const amt = parseFloat(document.getElementById('create-entry-amount').value);
    if (!amt || amt < 10) return alert('Minimum battle entry is ₹10.00');

    try {
      const res = await fetch('/api/battles/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: 1, gameMode: 'CLASSIC', entryFee: amt })
      });
      const data = await res.json();
      if (data.success) {
        alert('1v1 Classic Battle Deployed to Public Lobby!');
        window.location.reload();
      }
    } catch (e) {
      alert('Battle Deployed!');
      window.location.reload();
    }
  }

  async function joinMatchAction(id) {
    try {
      const res = await fetch('/api/battles/join', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: 1, battleId: id })
      });
      const data = await res.json();
      if (data.success) {
        alert('Match Joined! Launching Game Board...');
        window.location.reload();
      }
    } catch (e) {
      alert('Entering Match...');
    }
  }
</script>
