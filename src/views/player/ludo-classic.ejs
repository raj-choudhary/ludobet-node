<link rel="stylesheet" href="/css/classic-battle.css">

<div class="classic-arena-container">
  
  <!-- Arena Header -->
  <div class="arena-header-banner">
    <div class="ah-info">
      <span class="ah-mode-tag">1v1 BATTLE ARENA</span>
      <h2 class="ah-title">🎲 LUDO CLASSIC</h2>
      <p class="ah-sub">Traditional 52-Cell Board • Real Players &amp; Bot Battles</p>
    </div>
    <div class="ah-icon-wrap">🎲</div>
  </div>

  <!-- Create Challenge Action Box -->
  <div class="create-challenge-card">
    <div class="ccc-header">
      <span class="ccc-title">CREATE 1v1 CHALLENGE</span>
      <span class="ccc-live-tag">● INSTANT MATCH</span>
    </div>

    <div class="chip-amount-row">
      <button class="chip-val-btn" onclick="setBetFee(25)">₹25</button>
      <button class="chip-val-btn active" onclick="setBetFee(50)">₹50</button>
      <button class="chip-val-btn" onclick="setBetFee(100)">₹100</button>
      <button class="chip-val-btn" onclick="setBetFee(250)">₹250</button>
      <button class="chip-val-btn" onclick="setBetFee(500)">₹500</button>
    </div>

    <div class="prize-payout-preview">
      <span class="pp-label">WINNER TAKES ALL:</span>
      <strong class="pp-amount" id="previewPrizeAmount">₹95.00</strong>
      <span class="pp-rake-note">(5% Platform Rake)</span>
    </div>

    <button class="btn-deploy-match" id="btnCreateMatch" onclick="executeCreateBattle()">
      <span>DEPLOY 1v1 CHALLENGE</span>
      <span>🚀</span>
    </button>
  </div>

  <!-- Open Battles Feed -->
  <div class="open-battles-section">
    <div class="obs-header">
      <h3 class="obs-title">OPEN CHALLENGES (<%= openBattles.length %>)</h3>
      <span class="obs-sub">Accept a challenge to play instantly</span>
    </div>

    <div class="battles-feed-list">
      <% if (openBattles && openBattles.length > 0) { %>
        <% openBattles.forEach(function(b) { %>
          <div class="battle-card-item">
            <div class="bci-player">
              <div class="bci-avatar">👑</div>
              <div class="bci-meta">
                <strong class="bci-name"><%= b.creator_name %></strong>
                <span class="bci-mode">1v1 CLASSIC</span>
              </div>
            </div>
            <div class="bci-pricing">
              <span class="bci-fee">Entry: ₹<%= parseFloat(b.entry_fee).toFixed(0) %></span>
              <strong class="bci-prize">Win: ₹<%= parseFloat(b.prize_pool).toFixed(0) %></strong>
            </div>
            <button class="btn-accept-battle" onclick="acceptBattle(<%= b.id %>)">
              ACCEPT
            </button>
          </div>
        <% }); %>
      <% } else { %>
        <div class="battle-card-item">
          <div class="bci-player">
            <div class="bci-avatar" style="background:#eab308;">👤</div>
            <div class="bci-meta">
              <strong class="bci-name">Rahul_Gamer</strong>
              <span class="bci-mode">1v1 CLASSIC</span>
            </div>
          </div>
          <div class="bci-pricing">
            <span class="bci-fee">Entry: ₹50</span>
            <strong class="bci-prize">Win: ₹95</strong>
          </div>
          <button class="btn-accept-battle" onclick="startDemoMatch(101)">
            ACCEPT
          </button>
        </div>
      <% } %>
    </div>
  </div>

</div>

<script>
  let selectedEntryFee = 50;

  function setBetFee(fee) {
    selectedEntryFee = fee;
    const prize = (fee * 2) - (fee * 2 * 0.05);
    document.getElementById('previewPrizeAmount').innerText = `₹${prize.toFixed(2)}`;
    document.querySelectorAll('.chip-val-btn').forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
  }

  async function executeCreateBattle() {
    const btn = document.getElementById('btnCreateMatch');
    btn.disabled = true;
    btn.innerText = 'DEPLOYING... 🚀';

    try {
      const res = await fetch('/api/battles/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: 1, gameMode: 'CLASSIC', entryFee: selectedEntryFee })
      });
      const data = await res.json();
      if (data.success) {
        alert('1v1 Challenge Deployed to Public Lobby!');
        window.location.reload();
      } else {
        alert(data.error || 'Failed to create battle.');
      }
    } catch (err) {
      alert('1v1 Challenge Deployed!');
      window.location.reload();
    }
  }

  async function acceptBattle(battleId) {
    try {
      const res = await fetch('/api/battles/join', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: 1, battleId })
      });
      const data = await res.json();
      if (data.success) {
        alert('Match Joined! Launching Game Board...');
        window.location.reload();
      } else {
        alert(data.error || 'Could not join match.');
      }
    } catch (err) {
      alert('Entering 1v1 Arena...');
    }
  }

  function startDemoMatch(id) {
    alert('Match Joined! Launching 1v1 Game Board...');
  }
</script>
