        </a>

        <a class="drawer-menu-card" onclick="closeDrawer(); window.location.href='support.html';">
          <div class="card-left-group">
            <div class="nav-card-icon icon-green">🎧</div>
            <div class="nav-card-text">
              <span class="card-title">Support / Help</span>
              <span class="card-sub">FAQ, 24x7 WhatsApp Support</span>
            </div>
          </div>
          <span class="nav-card-arrow">›</span>
        </a>

        <a class="drawer-menu-card" onclick="closeDrawer(); window.location.href='terms.html';">
          <div class="card-left-group">
            <div class="nav-card-icon icon-slate">⚖️</div>
            <div class="nav-card-text">
              <span class="card-title">Terms &amp; Conditions</span>
              <span class="card-sub">Fairplay &amp; User Agreements</span>
            </div>
          </div>
          <span class="nav-card-arrow">›</span>
        </a>

        <a class="drawer-menu-card" onclick="closeDrawer(); window.location.href='privacy.html';">
          <div class="card-left-group">
            <div class="nav-card-icon icon-slate">🔒</div>
            <div class="nav-card-text">
              <span class="card-title">Privacy Policy</span>
              <span class="card-sub">Privacy &amp; Data Security</span>
            </div>
          </div>
          <span class="nav-card-arrow">›</span>
        </a>

        <!-- Logout -->
        <a class="drawer-menu-card logout-card" onclick="closeDrawer(); window.location.href='settings.html';">
          <div class="card-left-group">
            <div class="nav-card-icon icon-red">🚪</div>
            <div class="nav-card-text">
              <span class="card-title danger">Logout</span>
              <span class="card-sub">Securely exit account</span>
            </div>
          </div>
          <span class="nav-card-arrow">›</span>
        </a>

      </div>

      <!-- 3. Drawer Footer (Fixed) -->
      <div class="drawer-bottom-footer">
        <span>Fairplay 100% Certified • v2.4.0</span>
      </div>
    </div>
  </div>

  <!-- Floating Daily Spin Widget -->
  <div class="floating-spin-widget" onclick="openDailySpinModal()" title="Free Daily Spin!">
    <div class="spin-widget-badge">🎡</div>
  </div>

  <!-- MODAL: DAILY LUCKY SPIN WHEEL -->
  <div class="drawer-backdrop" id="modal-spin-wheel" onclick="closeDailySpinModal()" style="display:none; align-items:center; justify-content:center; padding:16px;">
    <div class="spin-modal-card" onclick="event.stopPropagation()">
      <button class="flow-modal-close-btn" onclick="closeDailySpinModal()" aria-label="Close Spin Wheel">✕</button>
      
      <div class="flow-header-pill" style="background: linear-gradient(135deg, #f59e0b, #d97706); box-shadow:0 3px 8px rgba(217, 119, 6, 0.35); margin-bottom:6px;">🎡 DAILY LUCKY WHEEL</div>
      <h3 style="font-size:20px; font-weight:900; color:#0c2b64; margin-top:2px;">Spin &amp; Win Real Cash!</h3>
      <p style="font-size:11.5px; font-weight:600; color:#64748b; margin-top:2px;">1 Free Spin every 24 hours. Guaranteed prizes!</p>

      <!-- Wheel Graphic Frame -->
      <div class="spin-wheel-container">
        <div class="spin-wheel-pointer">▼</div>
        <canvas id="wheel-canvas" width="280" height="280" class="spin-wheel-canvas"></canvas>
        <div class="spin-center-hub" id="btn-spin-hub" onclick="triggerWheelSpin()">SPIN!</div>
      </div>

      <div class="spin-prize-box" id="spin-result-box">
        <span id="spin-result-text">🎯 Tap "SPIN!" in the center to test your luck!</span>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast-msg" id="toast-msg"></div>

  <!-- Interactive Logic -->
  <script src="app.js"></script>
</body>
</html>