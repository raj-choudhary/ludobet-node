<link rel="stylesheet" href="/css/withdraw.css">

<div class="withdraw-page-container">
  
  <!-- Header Card -->
  <div class="withdraw-balance-banner">
    <div class="w-banner-info">
      <span class="w-label">AVAILABLE WITHDRAWABLE WINNINGS</span>
      <div class="w-amount" id="withdrawableDisplay">
        ₹<%= parseFloat(wallet.winning_balance || 0).toFixed(2) %>
      </div>
    </div>
    <div class="w-shield-icon">🛡️</div>
  </div>

  <!-- Payout Mode Tabs -->
  <div class="payout-mode-tabs">
    <button class="p-tab active" id="tabUpi" onclick="switchPayoutMode('UPI')">
      <span>📱 Instant UPI ID</span>
    </button>
    <button class="p-tab" id="tabBank" onclick="switchPayoutMode('BANK')">
      <span>🏛️ Bank Transfer (IMPS)</span>
    </button>
  </div>

  <!-- Withdrawal Form -->
  <form id="payoutForm" onsubmit="executeWithdrawal(event)">
    <div class="form-field-box">
      <label class="field-label">ENTER WITHDRAWAL AMOUNT (₹)</label>
      <div class="field-input-wrap">
        <span class="input-prefix">₹</span>
        <input type="number" id="payoutAmountInput" class="custom-input-field" placeholder="Min ₹100 - Max ₹50,000" min="100" max="50000" required oninput="recalcTds()">
      </div>
    </div>

    <!-- UPI VPA Field -->
    <div class="form-field-box" id="upiFieldBox">
      <label class="field-label">ENTER UPI ID (VPA)</label>
      <div class="field-input-wrap">
        <span class="input-prefix">@</span>
        <input type="text" id="upiVpaInput" class="custom-input-field" placeholder="e.g. username@okhdfcbank" required>
      </div>
    </div>

    <!-- Bank Fields -->
    <div id="bankFieldBox" style="display:none;">
      <div class="form-field-box">
        <label class="field-label">ACCOUNT NUMBER</label>
        <div class="field-input-wrap">
          <span class="input-prefix">#</span>
          <input type="text" id="bankAccInput" class="custom-input-field" placeholder="Bank Account Number">
        </div>
      </div>
      <div class="form-field-box" style="margin-top:10px;">
        <label class="field-label">IFSC CODE</label>
        <div class="field-input-wrap">
          <span class="input-prefix">🏛️</span>
          <input type="text" id="bankIfscInput" class="custom-input-field" placeholder="e.g. HDFC0001234">
        </div>
      </div>
    </div>

    <!-- Section 194BA Tax Card -->
    <div class="tds-calculation-card">
      <div class="tds-line">
        <span>Gross Withdrawal</span>
        <span id="tdsGross">₹0.00</span>
      </div>
      <div class="tds-line">
        <span>Section 194BA TDS (30% on Net Winnings)</span>
        <span id="tdsTax">₹0.00</span>
      </div>
      <div class="tds-line tds-net-line">
        <span>Net Bank Credit Amount</span>
        <span id="tdsNet">₹0.00</span>
      </div>
    </div>

    <button type="submit" class="btn-confirm-withdraw" id="btnWithdrawSubmit">
      <span>CONFIRM WITHDRAWAL TRANSFER</span>
      <span>➔</span>
    </button>
  </form>

  <div class="rbi-compliance-note">
    <span>🔒 100% RBI &amp; Income Tax Compliant Instant Payout Pipeline</span>
  </div>

</div>

<script>
  let activePayoutMode = 'UPI';

  function switchPayoutMode(mode) {
    activePayoutMode = mode;
    document.getElementById('tabUpi').classList.toggle('active', mode === 'UPI');
    document.getElementById('tabBank').classList.toggle('active', mode === 'BANK');

    if (mode === 'UPI') {
      document.getElementById('upiFieldBox').style.display = 'block';
      document.getElementById('bankFieldBox').style.display = 'none';
      document.getElementById('upiVpaInput').required = true;
    } else {
      document.getElementById('upiFieldBox').style.display = 'none';
      document.getElementById('bankFieldBox').style.display = 'block';
      document.getElementById('upiVpaInput').required = false;
    }
  }

  function recalcTds() {
    const amt = parseFloat(document.getElementById('payoutAmountInput').value) || 0;
    const tds = (amt > 0) ? (amt * 0.00) : 0;
    const net = amt - tds;

    document.getElementById('tdsGross').innerText = `₹${amt.toFixed(2)}`;
    document.getElementById('tdsTax').innerText = `₹${tds.toFixed(2)}`;
    document.getElementById('tdsNet').innerText = `₹${net.toFixed(2)}`;
  }

  async function executeWithdrawal(e) {
    e.preventDefault();
    const amt = parseFloat(document.getElementById('payoutAmountInput').value);
    if (!amt || amt < 100) return alert('Minimum withdrawal amount is ₹100.00');

    const details = (activePayoutMode === 'UPI') 
      ? document.getElementById('upiVpaInput').value.trim() 
      : `${document.getElementById('bankAccInput').value.trim()} (${document.getElementById('bankIfscInput').value.trim()})`;

    const btn = document.getElementById('btnWithdrawSubmit');
    btn.disabled = true;
    btn.innerText = 'PROCESSING TRANSFER... ⏳';

    try {
      const res = await fetch('/api/wallet/withdraw', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: 1, amount: amt, payoutMethod: activePayoutMode, payoutDetails: details })
      });
      const data = await res.json();
      if (data.success) {
        alert(`Transfer Successful! ₹${amt.toFixed(2)} sent to your ${activePayoutMode} account.`);
        window.location.href = '/wallet';
      } else {
        alert(data.error || 'Withdrawal failed.');
      }
    } catch (err) {
      alert('Withdrawal request simulated.');
      window.location.href = '/wallet';
    }
  }
</script>
