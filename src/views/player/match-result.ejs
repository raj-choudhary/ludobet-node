<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Submit Match Result | Ludo Tournament King</title>
  <meta name="description" content="Submit match winning screenshot proof or report match outcome for tournament verification.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="match-result.css">
</head>
<body>
  <div class="app-container">
    
    <!-- 1. TOP HEADER (Menu + Resource Pill) -->
    <header class="top-header">
      <button class="btn-menu" id="btn-menu" aria-label="Menu" onclick="window.location.href='index.html'">
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>

      <div class="resource-pill">
        <a href="wallet.html" class="res-item" style="text-decoration:none;" aria-label="Wallet Balance">
          <img class="res-icon" src="assets/chip.svg" alt="Chips">
          <div class="res-data">
            <span class="res-amount" id="chips-value">₹1,250</span>
            <span class="res-label">Cash</span>
          </div>
          <span class="btn-plus">+</span>
        </a>

        <div class="res-item" aria-label="Gems">
          <img class="res-icon" src="assets/diamond.svg" alt="Gems">
          <div class="res-data">
            <span class="res-amount" id="earnings-value">20</span>
            <span class="res-label">Gems</span>
          </div>
        </div>

        <button class="bell-item" onclick="window.location.href='notifications.html'" aria-label="Notifications">
          <div class="bell-icon-wrapper">
            <img class="bell-icon" src="assets/bell.svg" alt="Bell">
            <span class="bell-badge">3</span>
          </div>
        </button>
      </div>
    </header>

    <!-- Sub-Header Bar (Proper Gap & Back Navigation) -->
    <div class="sub-header-bar">
      <button class="btn-back" onclick="window.location.href='match-room.html'" aria-label="Go Back">←</button>
      <div class="page-title-group">
        <h1 class="result-page-title">
          <span class="title-green">MATCH</span> <span class="title-blue">RESULT</span>
        </h1>
        <span class="page-subtitle">Battle ID: #BTL-9284 • 1v1 Classic</span>
      </div>
      <div class="status-pill pending">
        ⏳ VERIFICATION
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <main class="result-body">

      <!-- 1. MATCH RECAP BANNER -->
      <section class="match-recap-banner">
        <div class="recap-players-row">
          <div class="recap-player">
            <img src="assets/avatar_rajendra.png" alt="You" class="recap-avatar">
            <span class="recap-name">Rajendra (You)</span>
          </div>
          <span class="recap-vs">VS</span>
          <div class="recap-player">
            <img src="assets/avatar_rahul.png" alt="Rahul" class="recap-avatar">
            <span class="recap-name">Rahul Kumar</span>
          </div>
        </div>
        <div class="recap-stats-strip">
          <span>Entry: <strong>₹50.00</strong></span>
          <span class="dot">•</span>
          <span>Winning Prize: <strong class="text-green">₹95.00</strong></span>
          <span class="dot">•</span>
          <span>Mode: <strong>1v1 Classic</strong></span>
        </div>
      </section>

      <!-- 2. RESULT SELECTION CARDS (CHOOSE OUTCOME) -->
      <section class="outcome-selection-section">
        <span class="section-label">SELECT YOUR MATCH OUTCOME:</span>
        <div class="outcome-cards-grid">
          
          <!-- Card 1: I WON -->
          <div class="outcome-card won selected" id="card-won" onclick="selectOutcome('won')">
            <div class="outcome-radio-circle">✓</div>
            <div class="outcome-icon">🏆</div>
            <div class="outcome-texts">
              <span class="outcome-title">I WON</span>
              <span class="outcome-sub">Claim ₹95.00 Prize Pool</span>
            </div>
            <span class="outcome-badge prize">+₹95.00</span>
          </div>

          <!-- Card 2: I LOST -->
          <div class="outcome-card lost" id="card-lost" onclick="selectOutcome('lost')">
            <div class="outcome-radio-circle"></div>
            <div class="outcome-icon">❌</div>
            <div class="outcome-texts">
              <span class="outcome-title">I LOST</span>
              <span class="outcome-sub">Concede match defeat</span>
            </div>
            <span class="outcome-badge lost">0 Winnings</span>
          </div>

          <!-- Card 3: CANCEL / ISSUE -->
          <div class="outcome-card cancel" id="card-cancel" onclick="selectOutcome('cancel')">
            <div class="outcome-radio-circle"></div>
            <div class="outcome-icon">⚠️</div>
            <div class="outcome-texts">
              <span class="outcome-title">CANCEL / ISSUE</span>
              <span class="outcome-sub">Opponent cheated / Error</span>
            </div>
            <span class="outcome-badge refund">Refund Req</span>
          </div>

        </div>
      </section>

      <!-- 3. SCREENSHOT UPLOAD HUB (ACTIVE WHEN WON OR CANCEL SELECTED) -->
      <section class="screenshot-upload-card" id="screenshot-section">
        <div class="upload-header">
          <span class="upload-heading">📸 UPLOAD WINNING SCREENSHOT (MANDATORY)</span>
          <span class="upload-sub">Take clear screenshot of Ludo King game winning screen</span>
        </div>

        <!-- Upload Dropzone Area -->
        <div class="upload-dropzone" id="upload-dropzone" onclick="triggerFileInput()">
          <input type="file" id="screenshot-file-input" accept="image/*" style="display:none;" onchange="handleFileSelected(event)">
          
          <!-- State 1: Empty Placeholder -->
          <div class="dropzone-empty" id="dropzone-empty">
            <div class="upload-icon-circle">📷</div>
            <span class="dropzone-title">Click to Upload Winning Screenshot</span>
            <span class="dropzone-sub">Supports JPG, PNG, WEBP (Max 10MB)</span>
            <button class="btn-browse-photo" type="button">CHOOSE FROM GALLERY</button>
          </div>

          <!-- State 2: Image Preview with Change Button -->
          <div class="dropzone-preview" id="dropzone-preview" style="display:none;">
            <img src="" alt="Screenshot Preview" class="preview-img" id="preview-img">
            <div class="preview-overlay">
              <span class="preview-tag">✅ Screenshot Attached</span>
              <button class="btn-change-photo" onclick="event.stopPropagation(); triggerFileInput()">Change Photo 🔄</button>
            </div>
          </div>
        </div>

        <!-- Guide Thumbnail Strip -->
        <div class="sample-guide-strip" onclick="showSampleGuide()">
          <span class="guide-icon">💡</span>
          <span class="guide-text">How a valid Ludo King Winning screen looks like? <strong class="text-link">View Example</strong></span>
        </div>
      </section>

      <!-- 4. CANCEL / DISPUTE REASON PICKER (SHOWN ONLY IF CANCEL SELECTED) -->
      <section class="dispute-reason-card" id="dispute-reason-section" style="display:none;">
        <span class="section-label">SELECT REASON FOR CANCELLATION / DISPUTE:</span>
        <div class="reasons-pill-list">
          <label class="reason-pill-item">
            <input type="radio" name="dispute-type" value="Opponent left early" checked>
            <span>Opponent left / disconnected early</span>
          </label>
          <label class="reason-pill-item">
            <input type="radio" name="dispute-type" value="Wrong Game Room">
            <span>Opponent joined wrong game mode</span>
          </label>
          <label class="reason-pill-item">
            <input type="radio" name="dispute-type" value="Cheating / Mod App">
            <span>Opponent used third-party cheat/mod</span>
          </label>
          <label class="reason-pill-item">
            <input type="radio" name="dispute-type" value="Other">
            <span>Other issue</span>
          </label>
        </div>
      </section>

      <!-- 5. ANTI-FRAUD & PENALTY WARNING BANNER -->
      <div class="fairplay-warning-card">
        <div class="warning-icon">⚠️</div>
        <div class="warning-texts">
          <span class="warning-title">STRICT FAIRPLAY POLICY</span>
          <span class="warning-desc">Uploading fake, edited, or previous match screenshots will result in <strong>instant account ban + ₹100 penalty</strong>.</span>
        </div>
      </div>

      <!-- 6. SUBMIT BUTTON -->
      <div class="submit-action-wrap">
        <button class="btn-submit-result" id="btn-submit-result" onclick="submitMatchResult()">
          <span>🚀 SUBMIT RESULT FOR VERIFICATION</span>
        </button>
      </div>

    </main>

    <!-- Bottom Navigation -->
    <div class="bottom-nav-container">
      <nav class="bottom-nav">
        <button class="nav-tab" onclick="window.location.href='index.html'">
          <img class="nav-icon-svg" src="assets/home.svg" alt="Home">
          <span class="nav-label">Home</span>
        </button>
        <button class="nav-tab active" onclick="window.location.href='ludo-classic.html'">
          <img class="nav-icon-svg" src="assets/chip.svg" alt="Battles">
          <span class="nav-label">Battles</span>
        </button>
        <button class="nav-tab" onclick="window.location.href='ranking.html'">
          <img class="nav-icon-svg" src="assets/ranking.svg" alt="Leaderboard">
          <span class="nav-label">Ranking</span>
        </button>
        <button class="nav-tab" onclick="window.location.href='wallet.html'">
          <img class="nav-icon-svg" src="assets/wallet.svg" alt="Wallet">
          <span class="nav-label">Wallet</span>
        </button>
        <button class="nav-tab" onclick="window.location.href='profile.html'">
          <img class="nav-icon-svg" src="assets/profile.svg" alt="Profile">
          <span class="nav-label">Profile</span>
        </button>
      </nav>
      <div class="home-indicator"></div>
    </div>
  </div>

  <!-- VICTORY SUCCESS MODAL -->
  <div class="modal-backdrop" id="victory-modal">
    <div class="modal-card victory-card" onclick="event.stopPropagation()">
      <div class="victory-trophy-wrap">
        <img src="assets/trophy_gold_3d.png" alt="Victory" class="victory-trophy-img">
        <div class="victory-confetti">🎉 🎊 ⭐ 👑</div>
      </div>
      <h2 class="victory-title">RESULT SUBMITTED!</h2>
      <p class="victory-sub" id="victory-sub-msg">Your winning screenshot has been submitted for automated AI &amp; Admin verification.</p>
      
      <div class="victory-prize-box">
        <span class="prize-tag-label">PRIZE BEING CREDITED</span>
        <span class="prize-amount-large">+₹95.00</span>
        <span class="prize-wallet-note">Will be added directly to your Winnings Wallet</span>
      </div>

      <div class="victory-actions">
        <button class="modal-btn success" onclick="window.location.href='wallet.html'">VIEW IN WALLET 💰</button>
        <button class="modal-btn outline" onclick="window.location.href='ludo-classic.html'">PLAY ANOTHER BATTLE ⚔️</button>
      </div>
    </div>
  <!-- DISPUTE RESOLUTION MODAL -->
  <div class="modal-backdrop" id="dispute-modal">
    <div class="modal-card" style="text-align:left; max-width:440px;" onclick="event.stopPropagation()">
      <div style="display:inline-block; background:#fee2e2; color:#b91c1c; font-size:10px; font-weight:900; padding:4px 10px; border-radius:12px; border:1px solid #f87171; margin-bottom:8px;">⚠️ DISPUTE ESCALATED</div>
      <h2 class="victory-title" style="color:#b91c1c; text-align:left;">Ticket #DISP-98421</h2>
      <p class="victory-sub" style="text-align:left; margin-bottom:14px;">Your dispute request has been assigned to our 24x7 Fairplay Moderation Desk.</p>

      <div style="background:#f8fbfe; border:1.5px solid #d4e5f7; border-radius:16px; padding:12px; margin-bottom:14px;">
        <div style="display:flex; justify-content:space-between; font-size:11.5px; margin-bottom:6px;">
          <span style="color:#64748b; font-weight:700;">Battle Entry Fee:</span>
          <strong style="color:#0c2b64;">₹50.00 (Escrow Locked 🔒)</strong>
        </div>
        <div style="display:flex; justify-content:space-between; font-size:11.5px; margin-bottom:6px;">
          <span style="color:#64748b; font-weight:700;">Resolution SLA:</span>
          <strong style="color:#16a34a;">Within 15 Minutes ⚡</strong>
        </div>
        <div style="display:flex; justify-content:space-between; font-size:11.5px;">
          <span style="color:#64748b; font-weight:700;">Opponent Status:</span>
          <strong style="color:#dc2626;">Under Verification</strong>
        </div>
      </div>

      <div class="victory-actions">
        <button class="modal-btn success" onclick="window.open('https://api.whatsapp.com/send?phone=919876543210', '_blank')">CHAT WITH MODERATOR ON WHATSAPP 💬</button>
        <button class="modal-btn outline" onclick="window.location.href='ludo-classic.html'">BACK TO BATTLE LOBBY ➔</button>
      </div>
    </div>
  </div>

  <!-- Interactive Toast -->
  <div class="app-toast" id="app-toast">
    <span class="toast-icon" id="toast-icon">⚡</span>
    <span class="toast-msg" id="toast-msg">Notification</span>
  </div>

  <script src="match-result.js"></script>
</body>
</html>
