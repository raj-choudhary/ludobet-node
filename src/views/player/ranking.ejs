<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Leaderboard &amp; Rankings — Ludo Bet</title>
  <meta name="description" content="Check top daily, weekly, and monthly tournament winners on Ludo Bet. Win real cash prizes up to ₹2,00,000!">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="classic-battle.css">
  <link rel="stylesheet" href="ranking.css">
</head>
<body>

  <!-- Ambient background sparkles -->
  <div class="ambient-sparkles"></div>

  <!-- Main Mobile App Frame -->
  <div class="app-container">

    <!-- 1. TOP HEADER BAR -->
    <header class="top-header">
      <!-- Menu Button -->
      <button class="btn-menu" id="btn-menu" aria-label="Menu" onclick="window.location.href='index.html'">
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>

      <!-- Resource Pill Container -->
      <div class="resource-pill">
        <!-- Chips Section -->
        <button class="res-item" onclick="showToast('Chips: 12,450', '🪙')" aria-label="Chips">
          <img class="res-icon" src="assets/chip.svg" alt="Chips">
          <div class="res-data">
            <span class="res-amount" id="chips-val">12,450</span>
            <span class="res-label">Chips</span>
          </div>
          <span class="btn-plus">+</span>
        </button>

        <!-- Earnings Section -->
        <button class="res-item" onclick="showToast('Earnings: ₹350', '💎')" aria-label="Earnings">
          <img class="res-icon" src="assets/diamond.svg" alt="Earnings">
          <div class="res-data">
            <span class="res-amount" id="earnings-val">350</span>
            <span class="res-label">Earnings</span>
          </div>
          <span class="btn-plus">+</span>
        </button>

        <!-- Notification Bell -->
        <button class="bell-item" onclick="showToast('3 New Notifications', '🔔')" aria-label="Notifications">
          <div class="bell-icon-wrapper">
            <img class="bell-icon" src="assets/bell.svg" alt="Bell">
            <span class="bell-badge">3</span>
          </div>
        </button>
      </div>
    </header>

    <!-- 2. SUB-HEADER WITH BACK BUTTON & TITLE -->
    <div class="sub-header-bar">
      <button class="btn-back" onclick="window.location.href='index.html'" aria-label="Back to Home">
        ←
      </button>
      <div class="page-title-group">
        <div class="ranking-page-title">
          <span class="title-purple">LEADER</span><span class="title-orange">BOARD</span>
        </div>
        <div class="page-subtitle">Top Players &amp; Big Cash Winners</div>
      </div>
    </div>

    <!-- 3. TIMEFRAME FILTER TABS -->
    <div class="leaderboard-tabs-bar">
      <button class="rank-tab active" id="tab-daily" onclick="switchLeaderboardTab('daily', this)">
        <span>🔥 Daily</span>
        <small class="tab-prize-tag">₹10K Pool</small>
      </button>
      <button class="rank-tab" id="tab-weekly" onclick="switchLeaderboardTab('weekly', this)">
        <span>⚡ Weekly</span>
        <small class="tab-prize-tag">₹50K Pool</small>
      </button>
      <button class="rank-tab" id="tab-monthly" onclick="switchLeaderboardTab('monthly', this)">
        <span>👑 Monthly</span>
        <small class="tab-prize-tag">₹2 Lakh Pool</small>
      </button>
    </div>

    <!-- 4. COUNTDOWN RESET STRIP -->
    <div class="leaderboard-timer-strip">
      <div class="timer-left">
        <span class="timer-icon">⏳</span>
        <span>Resets in: <strong id="rank-countdown-timer">06h 42m 15s</strong></span>
      </div>
      <button class="btn-prize-pool-info" onclick="openPrizeModal()">
        <span>🏆 Prize Rules</span>
      </button>
    </div>

    <!-- 5. TOP 3 WINNERS PODIUM (GRAND 3D SHOWCASE) -->
    <section class="podium-showcase-card">
      <div class="podium-sunburst"></div>

      <div class="podium-container">
        <!-- Rank 2: Silver (Left) -->
        <div class="podium-col rank-2">
          <div class="podium-avatar-wrapper">
            <span class="podium-crown">🥈</span>
            <img src="assets/avatar_amit.png" alt="Rank 2" class="podium-avatar-img" id="podium-img-2">
            <span class="podium-rank-tag silver">#2</span>
          </div>
          <div class="podium-player-name" id="podium-name-2">Amit_Pro</div>
          <div class="podium-score-pill" id="podium-score-2">42 Wins</div>
          <div class="podium-prize-badge" id="podium-prize-2">₹3,000</div>
          <div class="podium-pedestal silver">
            <span>2</span>
          </div>
        </div>

        <!-- Rank 1: Gold (Center & Elevated) -->
        <div class="podium-col rank-1">
          <div class="podium-avatar-wrapper rank-1-avatar">
            <span class="podium-crown gold-crown">👑</span>
            <img src="assets/avatar_rahul.png" alt="Rank 1" class="podium-avatar-img" id="podium-img-1">
            <span class="podium-rank-tag gold">#1</span>
          </div>
          <div class="podium-player-name champion" id="podium-name-1">Rahul_King 🌟</div>
          <div class="podium-score-pill gold" id="podium-score-1">58 Wins</div>
          <div class="podium-prize-badge gold" id="podium-prize-1">₹5,000</div>
          <div class="podium-pedestal gold">
            <img src="assets/trophy_gold_3d.png" alt="Gold Trophy" class="podium-trophy-mini">
            <span>1</span>
          </div>
        </div>

        <!-- Rank 3: Bronze (Right) -->
        <div class="podium-col rank-3">
          <div class="podium-avatar-wrapper">
            <span class="podium-crown">🥉</span>
            <img src="assets/avatar_priya.png" alt="Rank 3" class="podium-avatar-img" id="podium-img-3">
            <span class="podium-rank-tag bronze">#3</span>
          </div>
          <div class="podium-player-name" id="podium-name-3">Priya_Queen</div>
          <div class="podium-score-pill" id="podium-score-3">35 Wins</div>
          <div class="podium-prize-badge" id="podium-prize-3">₹1,500</div>
          <div class="podium-pedestal bronze">
            <span>3</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. YOUR CURRENT PERSONAL RANK STICKY CARD -->
    <section class="user-my-rank-card">
      <div class="my-rank-left">
        <span class="my-rank-number">#14</span>
        <img src="assets/avatar_player45.png" alt="You" class="my-rank-avatar">
        <div class="my-rank-info">
          <div class="my-rank-name-row">
            <span class="my-rank-name">LudoMaster99 (You)</span>
            <span class="my-rank-tag">TOP 5% 🚀</span>
          </div>
          <span class="my-rank-stats">18 Matches Won • 74% Win Rate</span>
        </div>
      </div>
      <div class="my-rank-right">
        <span class="my-rank-reward">+₹200</span>
        <span class="my-rank-status">Eligible Prize</span>
      </div>
    </section>

    <!-- 7. LEADERBOARD LIST (RANKS 4 TO 20) -->
    <section class="leaderboard-list-card">
      <div class="list-card-header">
        <span class="list-heading">TOP CONTENDERS (4-20)</span>
        <span class="list-count-badge">UPDATED LIVE</span>
      </div>

      <div class="leaderboard-items-container" id="leaderboard-items-list">
        <!-- Dynamically rendered via ranking.js -->
      </div>
    </section>

  </div>

  <!-- 8. BOTTOM FLOATING NAVIGATION DOCK -->
  <div class="bottom-nav-container">
    <nav class="bottom-nav">
      <button class="nav-tab" onclick="window.location.href='index.html'">
        <img class="nav-icon-svg" src="assets/home.svg" alt="Home">
        <span class="nav-label">Home</span>
      </button>
      <button class="nav-tab active" onclick="window.location.href='ranking.html'">
        <img class="nav-icon-svg" src="assets/ranking.svg" alt="Ranking">
        <span class="nav-label">Ranking</span>
      </button>
      <button class="nav-tab" onclick="window.location.href='wallet.html'">
        <img class="nav-icon-svg" src="assets/wallet.svg" alt="Wallet">
        <span class="nav-label">Wallet</span>
      </button>
      <button class="nav-tab" onclick="window.location.href='refer-earn.html'">
        <img class="nav-icon-svg" src="assets/refer.svg" alt="Refer">
        <span class="nav-label">Refer</span>
      </button>
      <button class="nav-tab" onclick="window.location.href='profile.html'">
        <img class="nav-icon-svg" src="assets/profile.svg" alt="Profile">
        <span class="nav-label">Profile</span>
      </button>
    </nav>
    <div class="home-indicator"></div>
  </div>

  <!-- PRIZE DISTRIBUTION RULES MODAL -->
  <div class="flow-modal-backdrop" id="modal-prize-rules">
    <div class="flow-modal-box" style="text-align: left;">
      <button class="flow-modal-close-btn" onclick="closePrizeModal()">✕</button>
      <div class="flow-header-pill" style="background:#ff8f00;">LEADERBOARD PRIZES</div>
      <h3 class="flow-title">Daily Prize Distribution</h3>
      <p class="flow-subtitle">Prizes are credited directly to wallet balance every night at 12:00 AM!</p>

      <div class="prize-table-box">
        <div class="prize-table-row header">
          <span>Rank</span>
          <span>Cash Prize</span>
        </div>
        <div class="prize-table-row highlight">
          <span>🥇 Rank 1</span>
          <strong>₹5,000 Real Cash</strong>
        </div>
        <div class="prize-table-row">
          <span>🥈 Rank 2</span>
          <strong>₹3,000 Real Cash</strong>
        </div>
        <div class="prize-table-row">
          <span>🥉 Rank 3</span>
          <strong>₹1,500 Real Cash</strong>
        </div>
        <div class="prize-table-row">
          <span>Rank 4 - 5</span>
          <strong>₹500 Cash Each</strong>
        </div>
        <div class="prize-table-row">
          <span>Rank 6 - 10</span>
          <strong>₹300 Cash Each</strong>
        </div>
        <div class="prize-table-row">
          <span>Rank 11 - 20 (You: #14)</span>
          <strong>₹200 Cash Each</strong>
        </div>
      </div>

      <button class="btn-flow-primary" onclick="closePrizeModal()">GOT IT, LET'S WIN!</button>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast-msg" id="toast-msg"></div>

  <!-- Ranking Logic Scripts -->
  <script src="ranking.js"></script>
</body>
</html>
