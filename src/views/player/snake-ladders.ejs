<link rel="stylesheet" href="/css/snake-gameplay.css">

<div class="classic-arena-container">
  
  <!-- Arena Header -->
  <div class="arena-header-banner" style="background:linear-gradient(135deg, #064e3b, #047857);">
    <div class="ah-info">
      <span class="ah-mode-tag" style="background:rgba(16,185,129,0.2); color:#10b981;">1-100 HAZARD DUEL</span>
      <h2 class="ah-title">🪜 SNAKES &amp; LADDERS</h2>
      <p class="ah-sub">Climb Ladders &amp; Dodge Venomous Snakes!</p>
    </div>
    <div class="ah-icon-wrap">🪜</div>
  </div>

  <!-- Create Challenge Action Box -->
  <div class="create-challenge-card">
    <div class="ccc-header">
      <span class="ccc-title">CREATE SNAKE &amp; LADDERS MATCH</span>
      <span class="ccc-live-tag" style="color:#10b981;">● 1v1 DUEL</span>
    </div>

    <div class="chip-amount-row">
      <button class="chip-val-btn" onclick="setSnakeFee(25)">₹25</button>
      <button class="chip-val-btn active" onclick="setSnakeFee(50)">₹50</button>
      <button class="chip-val-btn" onclick="setSnakeFee(100)">₹100</button>
      <button class="chip-val-btn" onclick="setSnakeFee(250)">₹250</button>
    </div>

    <div class="prize-payout-preview">
      <span class="pp-label">WINNER TAKES ALL:</span>
      <strong class="pp-amount" id="previewSnakePrize">₹95.00</strong>
      <span class="pp-rake-note">(5% Rake)</span>
    </div>

    <button class="btn-deploy-match" id="btnCreateSnake" style="background:linear-gradient(135deg, #10b981, #059669);" onclick="executeCreateSnake()">
      <span>DEPLOY SNAKE CHALLENGE</span>
      <span>🪜</span>
    </button>
  </div>

  <!-- Open Battles Feed -->
  <div class="open-battles-section">
    <div class="obs-header">
      <h3 class="obs-title">OPEN SNAKE DUELS (<%= openBattles.length %>)</h3>
    </div>

    <div class="battles-feed-list">
      <% if (openBattles && openBattles.length > 0) { %>
        <% openBattles.forEach(function(b) { %>
          <div class="battle-card-item">
            <div class="bci-player">
              <div class="bci-avatar" style="background:#10b981;">🪜</div>
              <div class="bci-meta">
                <strong class="bci-name"><%= b.creator_name %></strong>
                <span class="bci-mode" style="color:#10b981;">1v1 SNAKE</span>
              </div>
            </div>
            <div class="bci-pricing">
              <span class="bci-fee">Entry: ₹<%= parseFloat(b.entry_fee).toFixed(0) %></span>
              <strong class="bci-prize" style="color:#10b981;">Win: ₹<%= parseFloat(b.prize_pool).toFixed(0) %></strong>
            </div>
            <button class="btn-accept-battle" style="background:#10b981;" onclick="acceptBattle(<%= b.id %>)">
              ACCEPT
            </button>
          </div>
        <% }); %>
      <% } else { %>
        <div class="battle-card-item">
          <div class="bci-player">
            <div class="bci-avatar" style="background:#10b981;">🪜</div>
            <div class="bci-meta">
              <strong class="bci-name">Aman_Gamer</strong>
              <span class="bci-mode" style="color:#10b981;">1v1 SNAKE</span>
            </div>
          </div>
          <div class="bci-pricing">
            <span class="bci-fee">Entry: ₹50</span>
            <strong class="bci-prize" style="color:#10b981;">Win: ₹95</strong>
          </div>
          <button class="btn-accept-battle" style="background:#10b981;" onclick="alert('Entering Snake Duel Arena...')">
            ACCEPT
          </button>
        </div>
      <% } %>
    </div>
  </div>

</div>

<script>
  let snakeFee = 50;

  function setSnakeFee(fee) {
    snakeFee = fee;
    const prize = (fee * 2) - (fee * 2 * 0.05);
    document.getElementById('previewSnakePrize').innerText = `₹${prize.toFixed(2)}`;
    document.querySelectorAll('.chip-val-btn').forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
  }

  async function executeCreateSnake() {
    try {
      const res = await fetch('/api/battles/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: 1, gameMode: 'SNAKE', entryFee: snakeFee })
      });
      const data = await res.json();
      if (data.success) {
        alert('Snake & Ladders Challenge Deployed!');
        window.location.reload();
      }
    } catch (err) {
      alert('Challenge Deployed!');
      window.location.reload();
    }
  }

  async function acceptBattle(battleId) {
    try {
      const res = await fetch('/api/battles/join', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: 1, battleId })
      });
      const data = await res.json();
      if (data.success) {
        alert('Snake Match Joined!');
        window.location.reload();
      }
    } catch (err) {
      alert('Entering Snake Arena...');
    }
  }
</script>
