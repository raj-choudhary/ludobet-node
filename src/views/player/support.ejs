<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Customer Support & Helpdesk | Ludo Tournament King</title>
  <meta name="description" content="24x7 Customer Support, WhatsApp helpline, ticket submission, and match dispute resolution.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="support.css">
</head>
<body>
  <div class="app-container">
    
    <!-- 1. TOP HEADER (Menu + Resource Pill) -->
    <header class="top-header">
      <button class="btn-menu" id="btn-menu" aria-label="Menu" onclick="window.location.href='index.html'">
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>

      <div class="resource-pill">
        <a href="wallet.html" class="res-item" style="text-decoration:none;" aria-label="Wallet Balance">
          <img class="res-icon" src="assets/chip.svg" alt="Chips">
          <div class="res-data">
            <span class="res-amount" id="chips-value">₹1,250</span>
            <span class="res-label">Cash</span>
          </div>
          <span class="btn-plus">+</span>
        </a>

        <div class="res-item" aria-label="Gems">
          <img class="res-icon" src="assets/diamond.svg" alt="Gems">
          <div class="res-data">
            <span class="res-amount" id="earnings-value">20</span>
            <span class="res-label">Gems</span>
          </div>
        </div>

        <button class="bell-item" onclick="window.location.href='notifications.html'" aria-label="Notifications">
          <div class="bell-icon-wrapper">
            <img class="bell-icon" src="assets/bell.svg" alt="Bell">
            <span class="bell-badge">3</span>
          </div>
        </button>
      </div>
    </header>

    <!-- Sub-Header Bar -->
    <div class="sub-header-bar">
      <button class="btn-back" onclick="window.location.href='index.html'" aria-label="Go Back">←</button>
      <div class="page-title-group">
        <h1 class="support-page-title">
          <span class="title-green">SUPPORT</span> <span class="title-blue">&amp; HELP</span>
        </h1>
        <span class="page-subtitle">24x7 Live Customer Care &amp; Dispute Hub</span>
      </div>
      <div class="online-pill">
        🟢 24x7 ONLINE
      </div>
    </div>

    <!-- MAIN BODY -->
    <main class="support-body">

      <!-- 1. QUICK CONTACT CHANNELS -->
      <section class="quick-channels-grid">
        <a href="https://wa.me/919876543210" target="_blank" class="channel-card whatsapp">
          <div class="channel-icon-circle green">💬</div>
          <div class="channel-meta">
            <span class="channel-name">WhatsApp Support</span>
            <span class="channel-sub">Instant response in 2 mins</span>
          </div>
          <span class="channel-arrow">›</span>
        </a>

        <a href="mailto:support@ludotournamentking.com" class="channel-card email">
          <div class="channel-icon-circle blue">📧</div>
          <div class="channel-meta">
            <span class="channel-name">Email Helpdesk</span>
            <span class="channel-sub">support@ludotournamentking.com</span>
          </div>
          <span class="channel-arrow">›</span>
        </a>
      </section>

      <!-- 2. SUBMIT A HELP TICKET -->
      <section class="ticket-form-card">
        <span class="card-heading">📝 RAISE A SUPPORT TICKET</span>

        <div class="form-field">
          <label class="field-lbl">ISSUE CATEGORY</label>
          <select class="form-select" id="ticket-category">
            <option value="Match Dispute">Match Dispute / Opponent Cheating</option>
            <option value="Withdrawal Delay">Withdrawal / Payment Delay</option>
            <option value="Add Cash Issue">Deposit / Add Cash Issue</option>
            <option value="KYC Issue">KYC Document Verification</option>
            <option value="Other">Other Query</option>
          </select>
        </div>

        <div class="form-field">
          <label class="field-lbl">MATCH ID OR TRANSACTION ID (OPTIONAL)</label>
          <input type="text" class="form-text-input" placeholder="e.g. #BTL-9284 or TXN-9418">
        </div>

        <div class="form-field">
          <label class="field-lbl">DESCRIBE YOUR PROBLEM</label>
          <textarea class="form-textarea" placeholder="Explain your issue in detail so our support executive can resolve it quickly..." rows="3"></textarea>
        </div>

        <button class="btn-submit-ticket" onclick="submitHelpTicket()">
          🚀 SUBMIT SUPPORT TICKET
        </button>
      </section>

      <!-- 3. FREQUENTLY ASKED QUESTIONS (FAQ) -->
      <section class="faq-card">
        <span class="card-heading">❓ FREQUENTLY ASKED QUESTIONS (FAQ)</span>

        <div class="faq-item" onclick="toggleFaq(this)">
          <div class="faq-q-row">
            <span class="faq-q">How long does a withdrawal take to credit?</span>
            <span class="faq-arrow">▼</span>
          </div>
          <div class="faq-ans">
            UPI and IMPS Bank withdrawals are <strong>instant (credited within 60 seconds)</strong>. In rare banking network delays, it can take up to 15 minutes.
          </div>
        </div>

        <div class="faq-item" onclick="toggleFaq(this)">
          <div class="faq-q-row">
            <span class="faq-q">What happens if opponent disconnects or leaves?</span>
            <span class="faq-arrow">▼</span>
          </div>
          <div class="faq-ans">
            If the opponent leaves mid-match, take a screenshot of your victory screen and upload it in the Result screen. You will receive 100% of the prize pool.
          </div>
        </div>

        <div class="faq-item" onclick="toggleFaq(this)">
          <div class="faq-q-row">
            <span class="faq-q">What is the penalty for submitting fake results?</span>
            <span class="faq-arrow">▼</span>
          </div>
          <div class="faq-ans">
            We use AI image hash verification. Uploading edited or previous match screenshots incurs an instant ₹100 penalty + permanent account ban.
          </div>
        </div>
      </section>

    </main>

    <!-- Bottom Navigation -->
    <div class="bottom-nav-container">
      <nav class="bottom-nav">
        <button class="nav-tab" onclick="window.location.href='index.html'">
          <img class="nav-icon-svg" src="assets/home.svg" alt="Home">
          <span class="nav-label">Home</span>
        </button>
        <button class="nav-tab" onclick="window.location.href='ludo-classic.html'">
          <img class="nav-icon-svg" src="assets/chip.svg" alt="Battles">
          <span class="nav-label">Battles</span>
        </button>
        <button class="nav-tab" onclick="window.location.href='ranking.html'">
          <img class="nav-icon-svg" src="assets/ranking.svg" alt="Leaderboard">
          <span class="nav-label">Ranking</span>
        </button>
        <button class="nav-tab" onclick="window.location.href='wallet.html'">
          <img class="nav-icon-svg" src="assets/wallet.svg" alt="Wallet">
          <span class="nav-label">Wallet</span>
        </button>
        <button class="nav-tab active" onclick="window.location.href='profile.html'">
          <img class="nav-icon-svg" src="assets/profile.svg" alt="Profile">
          <span class="nav-label">Profile</span>
        </button>
      </nav>
      <div class="home-indicator"></div>
    </div>
  </div>

  <!-- Toast -->
  <div class="app-toast" id="app-toast">
    <span class="toast-icon" id="toast-icon">⚡</span>
    <span class="toast-msg" id="toast-msg">Notification</span>
  </div>

  <script>
    function toggleFaq(item) {
      item.classList.toggle('open');
      const arrow = item.querySelector('.faq-arrow');
      arrow.innerText = item.classList.contains('open') ? '▲' : '▼';
    }

    function submitHelpTicket() {
      showToast('Ticket #TCK-8942 Created! Executive assigned.', '✅');
    }

    function showToast(msg, icon = '⚡') {
      const toast = document.getElementById('app-toast');
      const msgEl = document.getElementById('toast-msg');
      const iconEl = document.getElementById('toast-icon');
      if (!toast || !msgEl) return;
      msgEl.innerText = msg;
      if (iconEl) iconEl.innerText = icon;
      toast.classList.add('show');
      clearTimeout(toast._timeout);
      toast._timeout = setTimeout(() => toast.classList.remove('show'), 2400);
    }
  </script>
</body>
</html>
