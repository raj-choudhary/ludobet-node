      </div>

      <div style="display:grid; grid-template-columns:1fr 1.5fr; gap:16px;">
        
        <!-- Adjustment Console Card -->
        <div class="admin-data-panel">
          <h2 style="font-size:16px; font-weight:900; color:#0f172a;">Execute Balance Adjustment</h2>
          <p style="font-size:11.5px; color:#64748b; margin-top:2px;">Every single balance edit is permanently logged to the Master Audit Ledger.</p>

          <div class="audit-field-group" style="margin-top:14px;">
            <label style="font-size:11px; font-weight:800; color:#475569;">Target Player ID:</label>
            <input type="text" id="man-target-player" value="LD10458" style="padding:8px 12px; border-radius:10px; border:1.5px solid #cbd5e1; font-weight:800;">
          </div>

          <div class="audit-field-group">
            <label style="font-size:11px; font-weight:800; color:#475569;">Action Type:</label>
            <select id="man-action-type" style="padding:8px 12px; border-radius:10px; border:1.5px solid #cbd5e1; font-weight:800; font-family:inherit;">
              <option value="credit">➕ CREDIT (Add Funds)</option>
              <option value="debit">➖ DEBIT (Deduct Funds)</option>
            </select>
          </div>

          <div class="audit-field-group">
            <label style="font-size:11px; font-weight:800; color:#475569;">Wallet Type:</label>
            <select id="man-wallet-type" style="padding:8px 12px; border-radius:10px; border:1.5px solid #cbd5e1; font-weight:800; font-family:inherit;">
              <option value="winnings">🏆 Winnings Cash (Withdrawable)</option>
              <option value="deposit">💳 Deposit Cash (Add Money)</option>
              <option value="bonus">🎁 Bonus Cash (Promotional)</option>
            </select>
          </div>

          <div class="audit-field-group">
            <label style="font-size:11px; font-weight:800; color:#475569;">Amount (₹):</label>
            <input type="number" id="man-amount-val" value="250" style="padding:8px 12px; border-radius:10px; border:1.5px solid #cbd5e1; font-weight:900; font-size:15px;">
          </div>

          <div class="audit-field-group">
            <label style="font-size:11px; font-weight:800; color:#ef4444;">Mandatory Admin Reason (Audit Rationale):</label>
            <textarea class="audit-reason-textarea" id="man-reason-text" placeholder="Explain the reason for adjustment (e.g. Tournament winner prize, incorrect dispute reversal)..."></textarea>
          </div>

          <button class="btn-table-action" style="width:100%; background:#6366f1; color:#fff; padding:12px 0; font-size:13px; margin-top:16px;" onclick="executeManualAdjustment()">
            SUBMIT ADJUSTMENT WITH AUDIT LOG ➔
          </button>
        </div>

        <!-- Recent Adjustments History -->
        <div class="admin-data-panel">
          <h2 style="font-size:16px; font-weight:900; color:#0f172a;">Recent Manual Corrections Log</h2>
          <p style="font-size:11.5px; color:#64748b; margin-top:2px;">Audited balance operations performed by Super Admin and authorized staff.</p>

          <div class="admin-table-frame" style="margin-top:12px;">
            <table class="admin-data-table">
              <thead>
                <tr>
                  <th>Player</th>
                  <th>Type &amp; Wallet</th>
                  <th>Amount</th>
                  <th>Reason Rationale</th>
                  <th>Admin</th>
                  <th>Time</th>
                </tr>
              </thead>
              <tbody id="adjustments-table-body">
                <tr>
                  <td><strong>LD10458</strong> (Rajendra)</td>
                  <td><span class="status-pill-badge approved">CREDIT (Winnings)</span></td>
                  <td><strong style="color:#10b981;">+₹200.00</strong></td>
                  <td><em>"Tourney Winner Compensation"</em></td>
                  <td>Super Admin</td>
                  <td>18 Aug, 14:10</td>
                </tr>
                <tr>
                  <td><strong>LD30912</strong> (Amit)</td>
                  <td><span class="status-pill-badge rejected">DEBIT (Deposit)</span></td>
                  <td><strong style="color:#ef4444;">-₹100.00</strong></td>
                  <td><em>"Chargeback Reversal"</em></td>
                  <td>Priya (Finance)</td>
                  <td>18 Aug, 11:45</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </main>
  </div>

  <script src="admin.js"></script>
  <script>
    function executeManualAdjustment() {
      const pid = document.getElementById('man-target-player').value.trim();
      const type = document.getElementById('man-action-type').value;
      const wallet = document.getElementById('man-wallet-type').value;
      const amt = parseFloat(document.getElementById('man-amount-val').value) || 0;
      const reason = document.getElementById('man-reason-text').value.trim();

      if (!reason) {
        alert('Mandatory Reason is required for wallet adjustments!');
        return;
      }

      showToast(`Adjusted ₹${amt} ${type.toUpperCase()} for ${pid}! Logged to Master Audit.`, '💰');
      document.getElementById('man-reason-text').value = '';
    }
  </script>
