<div class="admin-data-panel">
  <div class="data-panel-top-bar">
    <div>
      <h1 class="page-title-main">Player Directory</h1>
      <p class="page-title-sub">Search, inspect wallets, view game stats, and adjust account permissions.</p>
    </div>

    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <div class="data-search-input-box">
        <span>🔍</span>
        <input type="text" class="data-search-field" id="player-search-input" placeholder="Search by ID, Name, Phone..." onkeyup="filterPlayerTable()">
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="admin-table-frame">
    <table class="admin-data-table" id="players-table">
      <thead>
        <tr>
          <th>Player ID</th>
          <th>Player Name &amp; Phone</th>
          <th>Joined Date</th>
          <th>KYC Status</th>
          <th>Total Balance</th>
          <th>Account Type</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="players-table-body">
        <% if (players && players.length > 0) { %>
          <% players.forEach(function(p) { %>
            <tr>
              <td><strong>#LD<%= p.id %></strong></td>
              <td>
                <div style="display:flex; align-items:center; gap:8px;">
                  <span style="font-size:16px;">👤</span>
                  <div>
                    <strong style="color:#0f172a;"><%= p.name %></strong>
                    <div style="font-size:11px; color:#64748b;"><%= p.mobile %></div>
                  </div>
                </div>
              </td>
              <td><%= new Date(p.created_at).toLocaleDateString('en-IN') %></td>
              <td>
                <span class="status-tag <%= p.kyc_status === 'VERIFIED' ? 'verified' : 'pending' %>">
                  <%= p.kyc_status %>
                </span>
              </td>
              <td>
                <strong style="color:#059669;">₹<%= (parseFloat(p.deposit_balance || 0) + parseFloat(p.winning_balance || 0)).toFixed(2) %></strong>
              </td>
              <td>
                <span class="badge-role <%= p.is_bot ? 'bot' : 'player' %>">
                  <%= p.is_bot ? '🤖 HOUSE BOT' : 'REAL PLAYER' %>
                </span>
              </td>
              <td>
                <button class="btn-table-action" onclick="alert('Player #LD<%= p.id %>: <%= p.name %>')">Inspect</button>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align:center; padding:20px; color:#94a3b8;">No players found in database.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  function filterPlayerTable() {
    const q = document.getElementById('player-search-input').value.toLowerCase();
    const rows = document.querySelectorAll('#players-table-body tr');
    rows.forEach(r => {
      r.style.display = r.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
  }
</script>
