<div style="background:#0f172a; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:24px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <div>
      <h3 style="font-size:18px; font-weight:800;">Registered Players Master Records</h3>
      <span style="font-size:12px; color:#94a3b8;">Real player accounts, KYC verification statuses, and balance controls</span>
    </div>
  </div>

  <table style="width:100%; border-collapse:collapse; text-align:left; font-size:12.5px;">
    <thead>
      <tr style="border-bottom:1px solid rgba(255,255,255,0.1); color:#94a3b8;">
        <th style="padding:10px;">ID</th>
        <th style="padding:10px;">PLAYER NAME</th>
        <th style="padding:10px;">MOBILE</th>
        <th style="padding:10px;">DEPOSIT</th>
        <th style="padding:10px;">WINNINGS</th>
        <th style="padding:10px;">KYC</th>
        <th style="padding:10px;">STATUS</th>
        <th style="padding:10px;">ACTION</th>
      </tr>
    </thead>
    <tbody>
      <% if (players && players.length > 0) { %>
        <% players.forEach(function(p) { %>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
            <td style="padding:10px; color:#64748b;">#<%= p.id %></td>
            <td style="padding:10px;"><strong><%= p.name %></strong> <%= p.is_bot ? '🤖' : '' %></td>
            <td style="padding:10px; color:#94a3b8;"><%= p.mobile %></td>
            <td style="padding:10px;">₹<%= parseFloat(p.deposit_balance || 0).toFixed(2) %></td>
            <td style="padding:10px; color:#10b981; font-weight:700;">₹<%= parseFloat(p.winning_balance || 0).toFixed(2) %></td>
            <td style="padding:10px;">
              <span style="background:<%= p.kyc_status === 'VERIFIED' ? 'rgba(16,185,129,0.15)' : 'rgba(245,158,11,0.15)' %>; color:<%= p.kyc_status === 'VERIFIED' ? '#10b981' : '#f59e0b' %>; padding:3px 8px; border-radius:6px; font-weight:800; font-size:10px;">
                <%= p.kyc_status %>
              </span>
            </td>
            <td style="padding:10px;">
              <span style="color:<%= p.is_banned ? '#ef4444' : '#10b981' %>; font-weight:800;">
                <%= p.is_banned ? 'BANNED' : 'ACTIVE' %>
              </span>
            </td>
            <td style="padding:10px;">
              <button onclick="alert('Player status toggled.')" style="background:#1e293b; color:#fff; border:1px solid rgba(255,255,255,0.1); padding:4px 10px; border-radius:6px; cursor:pointer; font-size:11px;">
                <%= p.is_banned ? 'Unban' : 'Ban' %>
              </button>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="8" style="padding:20px; text-align:center; color:#64748b;">No players found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
