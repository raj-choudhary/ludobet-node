          <div style="display:flex; flex-direction:column; gap:14px;">
            <div>
              <label style="font-size:12px; font-weight:800; color:#475569; display:block; margin-bottom:6px;">Algorithm Engine Mode</label>
              <select id="engineMode" class="form-control-select" style="font-weight:700;">
                <option value="smart_rtp">🎯 Smart Adaptive RTP Mode (Balances Retention &amp; Fairness - Recommended)</option>
                <option value="crypto_fair">⚖️ 100% Cryptographic True Random RNG (Provably Fair)</option>
                <option value="house_edge">💎 House Maximizer Mode (Strict Margin Controller)</option>
              </select>
            </div>

            <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:14px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <span style="font-size:12px; font-weight:800; color:#0f172a;">Target Player Win Rate vs Bot (%)</span>
                <span class="slider-value-pill" id="playerWinPill">58%</span>
              </div>
              <div class="slider-range-box">
                <span style="font-size:11px; font-weight:700; color:#ef4444;">Hard (20%)</span>
                <input type="range" id="playerWinSlider" min="20" max="80" value="58" class="slider-range-input" oninput="document.getElementById('playerWinPill').innerText = this.value + '%'">
                <span style="font-size:11px; font-weight:700; color:#10b981;">Easy (80%)</span>
              </div>
              <p style="font-size:11px; color:#64748b; margin-top:6px;">
                Controls bot AI strength and roll luck. 58% ensures players feel rewarded while keeping game challenging.
              </p>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px;">
              <div>
                <strong style="font-size:12px; color:#0f172a;">Bot Dynamic Comeback Catch-Up Mechanic</strong>
                <p style="font-size:10.5px; color:#64748b; margin:2px 0 0;">Increases bot roll luck slightly when trailing by &gt; 15 cells.</p>
              </div>
              <input type="checkbox" id="botComeback" checked style="width:18px; height:18px; cursor:pointer;">
            </div>
          </div>
        </div>

        <!-- Dice Rolling & Six Probability Control -->
        <div class="admin-data-panel">
          <h2 style="font-size:15px; font-weight:800; color:#0f172a; margin-bottom:14px;">🎲 Dice RNG Biasing &amp; Roll Limits</h2>
          
          <div style="display:flex; flex-direction:column; gap:14px;">
            <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:14px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <span style="font-size:12px; font-weight:800; color:#0f172a;">Probability of Rolling '6' on Dice (%)</span>
                <span class="slider-value-pill" id="sixProbPill">18.5%</span>
              </div>
              <div class="slider-range-box">
                <span style="font-size:11px; font-weight:700; color:#64748b;">12.0%</span>
                <input type="range" id="sixProbSlider" min="12" max="25" step="0.5" value="18.5" class="slider-range-input" oninput="document.getElementById('sixProbPill').innerText = this.value + '%'">
                <span style="font-size:11px; font-weight:700; color:#64748b;">25.0%</span>
              </div>
              <p style="font-size:11px; color:#64748b; margin-top:6px;">
                Mathematical fair dice is 16.6%. Slight boost (18.5%) makes games faster and more exciting.
              </p>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px;">
              <div>
                <strong style="font-size:12px; color:#0f172a;">Consecutive Sixes Maximum Cap</strong>
                <p style="font-size:10.5px; color:#64748b; margin:2px 0 0;">3rd six cancels turn automatically according to standard rules.</p>
              </div>
              <select id="consecutiveSixes" class="form-control-select" style="width:110px; font-weight:800;">
                <option value="2">Max 2 (Standard)</option>
                <option value="3">Max 3</option>
                <option value="unlimited">Unlimited</option>
              </select>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px;">
              <div>
                <strong style="font-size:12px; color:#0f172a;">Home Finish Exact Number Assist</strong>
                <p style="font-size:10.5px; color:#64748b; margin:2px 0 0;">Reduces chances of rolling numbers greater than required steps.</p>
              </div>
              <input type="checkbox" id="homeAssist" checked style="width:18px; height:18px; cursor:pointer;">
            </div>
          </div>
        </div>

      </div>

      <!-- Row 2: Turn Timers, Forfeiture & Snake and Ladders Tuning -->
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-bottom:20px;">
        
        <!-- Game Timers & Forfeiture Rules -->
        <div class="admin-data-panel">
          <h2 style="font-size:15px; font-weight:800; color:#0f172a; margin-bottom:14px;">⏱️ Match Clock &amp; Disqualification Rules</h2>
          
          <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px; margin-bottom:14px;">
            <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:12px;">
              <label style="font-size:11.5px; font-weight:700; color:#475569; display:block; margin-bottom:6px;">Player Turn Clock (Sec)</label>
              <input type="number" id="turnTimer" value="15" min="8" max="30" class="form-control-input" style="font-weight:800; text-align:center;">
            </div>

            <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:12px;">
              <label style="font-size:11.5px; font-weight:700; color:#475569; display:block; margin-bottom:6px;">Max Auto-Misses Limit</label>
              <input type="number" id="missLimit" value="3" min="1" max="5" class="form-control-input" style="font-weight:800; text-align:center;">
            </div>
          </div>

          <div style="display:flex; flex-direction:column; gap:10px;">
            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px;">
              <div>
                <strong style="font-size:12px; color:#0f172a;">Auto-Play Token if 1 Move Available</strong>
                <p style="font-size:10.5px; color:#64748b; margin:2px 0 0;">Automatically moves token when only 1 valid path exists.</p>
              </div>
              <input type="checkbox" id="autoMoveSingle" checked style="width:18px; height:18px; cursor:pointer;">
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px;">
              <div>
                <strong style="font-size:12px; color:#0f172a;">Network Reconnection Buffer (Sec)</strong>
                <p style="font-size:10.5px; color:#64748b; margin:2px 0 0;">Time allowed for player to reconnect before auto-loss.</p>
              </div>
              <div style="width:90px;">
                <input type="number" id="reconnectBuffer" value="45" class="form-control-input" style="font-weight:800; text-align:center;">
              </div>
            </div>
          </div>
        </div>

        <!-- Snake & Ladders Specific Controls -->
        <div class="admin-data-panel">
          <h2 style="font-size:15px; font-weight:800; color:#0f172a; margin-bottom:14px;">🪜 Snake &amp; Ladders Specific Tuning</h2>
          
          <div style="display:flex; flex-direction:column; gap:14px;">
            <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:14px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <span style="font-size:12px; font-weight:800; color:#0f172a;">Ladder Boost vs Snake Bite Ratio</span>
                <span class="slider-value-pill" id="ladderRatioPill">55% Ladders</span>
              </div>
              <div class="slider-range-box">
                <span style="font-size:11px; font-weight:700; color:#ef4444;">More Snakes</span>
                <input type="range" id="ladderRatioSlider" min="30" max="70" value="55" class="slider-range-input" oninput="document.getElementById('ladderRatioPill').innerText = this.value + '% Ladders'">
                <span style="font-size:11px; font-weight:700; color:#10b981;">More Ladders</span>
              </div>
              <p style="font-size:11px; color:#64748b; margin-top:6px;">
                55% ladder bias accelerates matches and prevents long agonizing gameplay.
              </p>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px;">
              <div>
                <strong style="font-size:12px; color:#0f172a;">Block Fatal Snake at Cell 99 on Bot Turn</strong>
                <p style="font-size:10.5px; color:#64748b; margin:2px 0 0;">Prevents bot from landing on deadly 99->4 snake too easily.</p>
              </div>
              <input type="checkbox" id="block99Snake" checked style="width:18px; height:18px; cursor:pointer;">
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px;">
