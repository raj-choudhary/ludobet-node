  <script>
    function simulateDiceRolls(iterations) {
      const counts = [0, 0, 0, 0, 0, 0];
      const sixWeight = parseFloat(document.getElementById('sixProbSlider').value) / 100;
      const otherWeight = (1 - sixWeight) / 5;

      for (let i = 0; i < iterations; i++) {
        const rand = Math.random();
        if (rand < sixWeight) {
          counts[5]++;
        } else {
          const subRand = Math.random();
          const index = Math.floor(subRand * 5);
          counts[index]++;
        }
      }

      for (let d = 1; d <= 6; d++) {
        const c = counts[d - 1];
        const pct = ((c / iterations) * 100).toFixed(1);
        document.getElementById(`diceCount${d}`).innerText = `${pct}%`;
        document.getElementById(`diceFill${d}`).style.width = `${pct * 2}%`;
      }

      showToast(`Simulation complete: ${iterations.toLocaleString()} dice rolls evaluated!`, '🎲');
    }

    function saveEngineSettings() {
      const mode = document.getElementById('engineMode').value;
      const winRate = document.getElementById('playerWinSlider').value;
      const sixRate = document.getElementById('sixProbSlider').value;

      if (window.STATE && window.STATE.auditLogs) {
        window.STATE.auditLogs.unshift({
          action: "UPDATED_GAME_ENGINE_RNG",
          actor: "Super Admin (You)",
          time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
          details: `Game RNG Mode: ${mode}, Bot vs Human Win Target: ${winRate}%, Dice 6 Bias: ${sixRate}%`,
          ip: "103.241.12.89"
        });
      }

      showToast('Game Engine algorithms & RNG parameters updated!', '💾');
    }

    function resetEngineDefaults() {
      if (confirm("Reset all game engine probabilities to standard balanced defaults?")) {
        document.getElementById('engineMode').value = "smart_rtp";
        document.getElementById('playerWinSlider').value = 58;
        document.getElementById('playerWinPill').innerText = "58%";
        document.getElementById('sixProbSlider').value = 18.5;
        document.getElementById('sixProbPill').innerText = "18.5%";
        document.getElementById('consecutiveSixes').value = "2";
        document.getElementById('turnTimer').value = 15;
        document.getElementById('missLimit').value = 3;
        document.getElementById('ladderRatioSlider').value = 55;
        document.getElementById('ladderRatioPill').innerText = "55% Ladders";
        showToast('Engine parameters reset to defaults', '↺');
      }
    }
  </script>
