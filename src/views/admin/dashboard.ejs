<div class="admin-view-panel" id="view-dashboard" style="display:flex; flex-direction:column; gap:24px;">
  
  <!-- Page Title & Top Controls -->
  <div class="dashboard-page-title-row">
    <div>
      <h1 class="page-title-main">Dashboard</h1>
      <p class="page-title-sub">Welcome back, Super Admin 👋</p>
    </div>
    <div class="dashboard-controls-group">
      <button class="date-picker-btn">
        <span>📅</span>
        <span>Today Live Metrics</span>
      </button>
      <button class="btn-refresh-data" onclick="window.location.reload()">
        <span>↻</span>
        <span>Refresh</span>
      </button>
    </div>
  </div>

  <!-- ROW 1: FINANCIAL KPI STRIP (6 STAT CARDS) -->
  <div class="financial-kpi-grid">
    <!-- Card 1: Total Escrow -->
    <div class="kpi-stat-card">
      <div class="kpi-card-top">
        <div class="kpi-icon-bubble bubble-blue">💳</div>
        <span class="kpi-label-text">Total Real Escrow</span>
      </div>
      <div class="kpi-amount-val">₹<%= stats ? parseFloat(stats.totalEscrow || 0).toLocaleString('en-IN') : '24,45,230' %></div>
      <div class="kpi-trend-pill trend-up">
        <span>100% Segregated</span>
      </div>
    </div>

    <!-- Card 2: Organic P2P Rake -->
    <div class="kpi-stat-card">
      <div class="kpi-card-top">
        <div class="kpi-icon-bubble bubble-green">📈</div>
        <span class="kpi-label-text">Organic 1v1 Rake</span>
      </div>
      <div class="kpi-amount-val">₹<%= stats ? parseFloat(stats.totalRake || 0).toLocaleString('en-IN') : '3,31,555' %></div>
      <div class="kpi-trend-pill trend-up">
        <span>5% Platform Cut</span>
      </div>
    </div>

    <!-- Card 3: Bot GGR Profit -->
    <div class="kpi-stat-card">
      <div class="kpi-card-top">
        <div class="kpi-icon-bubble bubble-purple">🤖</div>
        <span class="kpi-label-text">House Bot GGR</span>
      </div>
      <div class="kpi-amount-val">₹<%= stats ? parseFloat(stats.botProfit || 0).toLocaleString('en-IN') : '6,63,110' %></div>
      <div class="kpi-trend-pill trend-up">
        <span>55% Target Margin</span>
      </div>
    </div>

    <!-- Card 4: Total Platform Revenue -->
    <div class="kpi-stat-card">
      <div class="kpi-card-top">
        <div class="kpi-icon-bubble bubble-teal">💰</div>
        <span class="kpi-label-text">Total Net Revenue</span>
      </div>
      <div class="kpi-amount-val">₹<%= stats ? parseFloat(stats.totalRevenue || 0).toLocaleString('en-IN') : '9,94,665' %></div>
      <div class="kpi-trend-pill trend-up">
        <span>↑ 16.20% Growth</span>
      </div>
    </div>
  </div>

  <!-- ROW 2: USER OVERVIEW SECTION -->
  <div class="user-overview-section">
    <div class="overview-header-row">
      <h2 class="section-block-title">User Overview</h2>
      <a href="/admin/players" class="link-all-action">View All Players ➔</a>
    </div>

    <div class="user-stat-grid">
      <!-- 1. Total Players -->
      <div class="user-mini-card">
        <div class="user-mini-icon bubble-blue">👥</div>
        <div class="user-mini-meta">
          <span class="user-mini-label">Total Real Players</span>
          <span class="user-mini-val"><%= stats ? stats.totalPlayers : 124580 %></span>
          <span class="user-mini-sub">● Database Registered</span>
        </div>
      </div>

      <!-- 2. Active Battles -->
      <div class="user-mini-card">
        <div class="user-mini-icon bubble-green">⚔️</div>
        <div class="user-mini-meta">
          <span class="user-mini-label">Open Battles</span>
          <span class="user-mini-val" style="color:#10b981;"><%= openBattles ? openBattles.length : 12 %></span>
          <span class="user-mini-sub">● Live in Lobby</span>
        </div>
      </div>

      <!-- 3. Pending Withdrawals -->
      <div class="user-mini-card">
        <div class="user-mini-icon bubble-amber">⌛</div>
        <div class="user-mini-meta">
          <span class="user-mini-label">Pending Payouts</span>
          <span class="user-mini-val" style="color:#d97706;"><%= stats ? stats.pendingPayouts : 0 %></span>
          <span class="user-mini-sub amber">Awaiting Admin Sign</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ROW 3: 1-CLICK GHOST BATTLE INJECTOR (STEALTH AI) -->
  <section class="admin-card-block" id="ghost-injector">
    <div class="card-block-header">
      <div class="card-header-left">
        <span class="block-icon">🚀</span>
        <h2 class="card-block-title">1-Click 1v1 Ghost Battle Injector</h2>
      </div>
      <span class="badge-stealth-ai">STEALTH AI</span>
    </div>

    <form class="ghost-injector-form" onsubmit="event.preventDefault(); injectGhostBattle();">
      <div class="form-row-grid">
        <div class="form-group">
          <label class="form-lbl">GAME MODE</label>
          <select class="admin-form-input" id="ghost-mode">
            <option value="CLASSIC">🎲 Ludo Classic (1v1)</option>
            <option value="QUICK">⚡ Ludo Quick Blitz (1v1)</option>
            <option value="SNAKE">🪜 Snake &amp; Ladders (1v1)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-lbl">BOT PERSONA</label>
          <select class="admin-form-input" id="ghost-bot">
            <% if (bots && bots.length > 0) { %>
              <% bots.forEach(function(b) { %>
                <option value="<%= b.id %>"><%= b.name %> (Level <%= b.player_level %>)</option>
              <% }); %>
            <% } else { %>
              <option value="101">Rahul_Gamer (Level 24)</option>
              <option value="102">Pooja_Patel (Level 19)</option>
              <option value="103">Aman_Gamer (Level 31)</option>
            <% } %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-lbl">ENTRY BET AMOUNT (₹)</label>
          <select class="admin-form-input" id="ghost-fee">
            <option value="20">₹20.00 (Win ₹38)</option>
            <option value="50" selected>₹50.00 (Win ₹95)</option>
            <option value="100">₹100.00 (Win ₹190)</option>
            <option value="250">₹250.00 (Win ₹475)</option>
            <option value="500">₹500.00 (Win ₹950)</option>
            <option value="1000">₹1,000.00 (Win ₹1,900)</option>
          </select>
        </div>
      </div>

      <button type="submit" class="btn-inject-action" style="margin-top:16px;">
        <span>🚀</span>
        <span>INJECT GHOST BATTLE TO PUBLIC LOBBY</span>
      </button>
    </form>
  </section>

  <!-- ROW 4: OPEN LOBBY BATTLES TABLE -->
  <section class="admin-card-block">
    <div class="card-block-header">
      <div class="card-header-left">
        <span class="block-icon">⚔️</span>
        <h2 class="card-block-title">Live Public Lobby Battles (<%= openBattles ? openBattles.length : 0 %>)</h2>
      </div>
    </div>

    <div class="table-responsive-box">
      <table class="admin-data-table">
        <thead>
          <tr>
            <th>Battle Code</th>
            <th>Mode</th>
            <th>Creator</th>
            <th>Entry Fee</th>
            <th>Prize Pool</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (openBattles && openBattles.length > 0) { %>
            <% openBattles.forEach(function(b) { %>
              <tr>
                <td><strong><%= b.battle_code %></strong></td>
                <td><span class="badge-mode"><%= b.game_mode %></span></td>
                <td><%= b.creator_name %></td>
                <td>₹<%= parseFloat(b.entry_fee).toFixed(2) %></td>
                <td style="color:#10b981; font-weight:800;">₹<%= parseFloat(b.prize_pool).toFixed(2) %></td>
                <td><span class="status-tag open"><%= b.status %></span></td>
                <td>
                  <button class="btn-table-action" onclick="alert('Battle <%= b.battle_code %> details')">View</button>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" style="text-align:center; padding:20px; color:#94a3b8;">
                No open battles currently. Inject a ghost battle above!
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

</div>

<script>
  async function injectGhostBattle() {
    const gameMode = document.getElementById('ghost-mode').value;
    const botId = document.getElementById('ghost-bot').value;
    const entryFee = parseFloat(document.getElementById('ghost-fee').value);

    try {
      const res = await fetch('/admin/inject-ghost-battle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ botId, gameMode, entryFee })
      });
      const data = await res.json();
      if (data.success) {
        alert('Ghost Battle Injected Successfully into Public Lobby!');
        window.location.reload();
      } else {
        alert('Error: ' + data.error);
      }
    } catch (e) {
      alert('Error injecting ghost battle.');
    }
  }
</script>
