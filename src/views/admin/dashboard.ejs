<div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:18px; margin-bottom:24px;">
  
  <div style="background:#0f172a; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:20px;">
    <span style="font-size:11px; font-weight:700; color:#94a3b8; text-transform:uppercase;">TOTAL REAL BANK ESCROW</span>
    <div style="font-size:26px; font-weight:900; color:#3b82f6; margin-top:4px;">
      ₹<%= parseFloat(auditSummary.realUserEscrowLiability.total_real_bank_escrow_liability || 0).toLocaleString('en-IN') %>
    </div>
    <span style="font-size:10px; color:#64748b;">100% Segregated Player Funds</span>
  </div>

  <div style="background:#0f172a; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:20px;">
    <span style="font-size:11px; font-weight:700; color:#94a3b8; text-transform:uppercase;">ORGANIC 1v1 P2P RAKE</span>
    <div style="font-size:26px; font-weight:900; color:#10b981; margin-top:4px;">
      ₹<%= parseFloat(auditSummary.p2pOrganicRakeRevenue || 0).toLocaleString('en-IN') %>
    </div>
    <span style="font-size:10px; color:#64748b;">5% Rake on Real vs Real</span>
  </div>

  <div style="background:#0f172a; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:20px;">
    <span style="font-size:11px; font-weight:700; color:#94a3b8; text-transform:uppercase;">HOUSE BOT GGR PROFIT</span>
    <div style="font-size:26px; font-weight:900; color:#f59e0b; margin-top:4px;">
      ₹<%= parseFloat(auditSummary.houseBotAccounting.houseBotNetProfit || 0).toLocaleString('en-IN') %>
    </div>
    <span style="font-size:10px; color:#64748b;">Shadow Virtual Bot Net Revenue</span>
  </div>

  <div style="background:#0f172a; border:1.5px solid #10b981; border-radius:16px; padding:20px; box-shadow:0 0 20px rgba(16,185,129,0.15);">
    <span style="font-size:11px; font-weight:700; color:#94a3b8; text-transform:uppercase;">TOTAL PLATFORM REVENUE</span>
    <div style="font-size:26px; font-weight:900; color:#10b981; margin-top:4px;">
      ₹<%= parseFloat(auditSummary.totalPlatformNetRevenue || 0).toLocaleString('en-IN') %>
    </div>
    <span style="font-size:10px; color:#10b981;">Organic Rake + Bot GGR Profit</span>
  </div>

</div>

<!-- 1-Click Ghost Bot Injector -->
<div style="background:#0f172a; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:24px; margin-bottom:24px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <div>
      <h3 style="font-size:16px; font-weight:800;">1-Click 1v1 Ghost Battle Injector</h3>
      <span style="font-size:11px; color:#94a3b8;">Instantly deploy high-liquidity bot challenges into public lobby</span>
    </div>
    <span style="font-size:10px; background:rgba(245,158,11,0.2); color:#f59e0b; padding:4px 8px; border-radius:6px; font-weight:800;">STEALTH AI</span>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:12px;">
    <div>
      <label style="font-size:10.5px; color:#94a3b8; font-weight:700; display:block; margin-bottom:4px;">GAME MODE</label>
      <select id="botGameMode" style="width:100%; padding:10px; background:#090d16; border:1px solid rgba(255,255,255,0.1); border-radius:10px; color:#fff; font-weight:700;">
        <option value="CLASSIC">🎲 Ludo Classic (1v1)</option>
        <option value="QUICK">⚡ Ludo Quick (1v1)</option>
        <option value="SNAKE">🪜 Snake &amp; Ladders (1v1)</option>
      </select>
    </div>

    <div>
      <label style="font-size:10.5px; color:#94a3b8; font-weight:700; display:block; margin-bottom:4px;">BOT PERSONA</label>
      <select id="botPersonaName" style="width:100%; padding:10px; background:#090d16; border:1px solid rgba(255,255,255,0.1); border-radius:10px; color:#fff; font-weight:700;">
        <option value="Rahul_Gamer">Rahul_Gamer (Lvl 24)</option>
        <option value="Pooja_Patel">Pooja_Patel (Lvl 19)</option>
        <option value="Aman_Gamer">Aman_Gamer (Lvl 31)</option>
        <option value="Sneha_99">Sneha_99 (Lvl 15)</option>
      </select>
    </div>

    <div>
      <label style="font-size:10.5px; color:#94a3b8; font-weight:700; display:block; margin-bottom:4px;">ENTRY BET AMOUNT (₹)</label>
      <select id="botEntryFee" style="width:100%; padding:10px; background:#090d16; border:1px solid rgba(255,255,255,0.1); border-radius:10px; color:#fff; font-weight:700;">
        <option value="25">₹25.00</option>
        <option value="50" selected>₹50.00</option>
        <option value="100">₹100.00</option>
        <option value="250">₹250.00</option>
        <option value="500">₹500.00</option>
      </select>
    </div>

    <div style="display:flex; align-items:flex-end;">
      <button onclick="injectGhostBattle()" style="width:100%; background:linear-gradient(135deg, #f59e0b, #d97706); color:#0f172a; border:none; padding:12px; border-radius:10px; font-weight:900; cursor:pointer;">
        <span>INJECT GHOST BATTLE 🚀</span>
      </button>
    </div>
  </div>
</div>

<script>
  async function injectGhostBattle() {
    const gameMode = document.getElementById('botGameMode').value;
    const botPersonaName = document.getElementById('botPersonaName').value;
    const entryFee = document.getElementById('botEntryFee').value;

    try {
      const res = await fetch('/api/admin/inject-ghost-battle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ gameMode, botPersonaName, entryFee })
      });
      const data = await res.json();
      if (data.success) {
        alert(`Success! 1v1 Ghost Battle ${data.battleCode} deployed to public lobby by ${botPersonaName}.`);
      }
    } catch (err) {
      alert('Injected to Lobby!');
    }
  }
</script>
