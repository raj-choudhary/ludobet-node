      </div>

      <div class="header-right-group">
        <button class="header-icon-btn">🔍</button>
        <button class="header-icon-btn">🔔</button>
        <div class="admin-user-pill">
          <div class="admin-avatar-circle"><span>👨‍💼</span></div>
          <div class="admin-user-info">
            <span class="admin-user-name">Super Admin</span>
            <span class="admin-user-role">Super Administrator</span>
          </div>
        </div>
      </div>
    </header>

    <main class="admin-body-container">
      <div class="admin-data-panel">
        <div class="data-panel-top-bar">
          <div>
            <h1 class="page-title-main">Employee Directory &amp; RBAC Roles</h1>
            <p class="page-title-sub">Manage staff members and assign granular permissions across support, finance, KYC, disputes.</p>
          </div>
          <button class="btn-table-action" style="background:#6366f1; color:#fff; padding:8px 16px; font-weight:800;" onclick="openAddEmployeeModal()">
            ➕ ADD NEW EMPLOYEE
          </button>
        </div>

        <div class="admin-table-frame">
          <table class="admin-data-table">
            <thead>
              <tr>
                <th>Staff ID</th>
                <th>Employee Name &amp; Email</th>
                <th>Assigned Role</th>
                <th>Allowed Modules</th>
                <th>Account Status</th>
                <th>Last Active</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="employees-table-body">
              <!-- Dynamically populated via admin.js -->
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <!-- ADD / EDIT EMPLOYEE MODAL -->
  <div class="admin-modal-overlay" id="modal-employee-form">
    <div class="admin-modal-window">
      <div class="admin-modal-header">
        <span class="admin-modal-title" id="emp-form-modal-title">➕ Add New Staff Member</span>
        <button class="admin-modal-close-btn" onclick="closeEmployeeModal()">✕</button>
      </div>
      <form onsubmit="saveEmployeeForm(event)" class="admin-modal-body">
        <input type="hidden" id="emp-edit-id">
        <div class="form-group-item">
          <label class="form-label-text">Employee Full Name</label>
          <input type="text" class="form-control-input" id="emp-name-input" placeholder="e.g. Vikram Malhotra" required>
        </div>
        <div class="form-group-item">
          <label class="form-label-text">Official Email / Staff Username</label>
          <input type="email" class="form-control-input" id="emp-email-input" placeholder="e.g. staff@ludobet.com" required>
        </div>
        <div class="form-group-item">
          <label class="form-label-text">Assigned Role (RBAC)</label>
          <select class="form-control-select" id="emp-role-select">
            <option value="super_admin">👑 Super Administrator (All 17 Modules)</option>
            <option value="finance">💰 Finance Executive (Deposits, Payouts, Ledger)</option>
            <option value="kyc">🪪 KYC Moderator (Aadhaar/PAN Verification)</option>
            <option value="dispute">⚔️ Dispute Referee (Screenshots &amp; Battles)</option>
            <option value="support">🎧 Customer Support (Tickets &amp; Inquiries)</option>
            <option value="marketing">📢 Marketing Manager (Banners &amp; Push)</option>
            <option value="security">🛡️ Security Analyst (Anti-Fraud &amp; Logs)</option>
          </select>
        </div>
        <div class="form-group-item">
          <label class="form-label-text">Account Status</label>
          <select class="form-control-select" id="emp-status-select">
            <option value="active">ACTIVE (Permitted to Log In)</option>
            <option value="suspended">SUSPENDED (Access Revoked)</option>
          </select>
        </div>
        <div class="admin-modal-footer" style="padding:0; background:transparent; border:none; margin-top:10px;">
          <button type="button" class="btn-table-action" onclick="closeEmployeeModal()">Cancel</button>
          <button type="submit" class="btn-table-action" style="background:#6366f1; color:#fff; padding:8px 18px; font-weight:800;">
            💾 Save Staff Record
          </button>
        </div>
      </form>
    </div>
