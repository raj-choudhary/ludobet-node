<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Master Admin 2FA Gateway — Ludo Bet</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
    body {
      background: radial-gradient(circle at 50% 20%, #1e1b4b 0%, #090d16 100%);
      color: #ffffff;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .admin-login-card {
      width: 100%;
      max-width: 440px;
      background: rgba(15, 23, 42, 0.85);
      border: 1.5px solid rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      padding: 36px 30px;
      box-shadow: 0 25px 60px rgba(0,0,0,0.8);
      backdrop-filter: blur(16px);
    }
    .input-field {
      width: 100%;
      background: #090d16;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      padding: 12px 14px;
      color: #ffffff;
      font-size: 13.5px;
      font-weight: 700;
      outline: none;
      margin-top: 6px;
    }
    .btn-auth {
      width: 100%;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #0f172a;
      border: none;
      padding: 14px;
      border-radius: 12px;
      font-weight: 900;
      font-size: 13.5px;
      cursor: pointer;
      margin-top: 22px;
    }
  </style>
</head>
<body>

  <div class="admin-login-card">
    <div style="text-align:center; margin-bottom:28px;">
      <span style="font-size:42px;">👑</span>
      <h1 style="font-size:22px; font-weight:900; margin-top:6px;">MASTER ADMIN PORTAL</h1>
      <span style="font-size:10px; font-weight:800; color:#f59e0b; letter-spacing:2px;">INSTITUTIONAL SECURITY GATEWAY</span>
    </div>

    <form onsubmit="handleAdminLogin(event)">
      <div style="margin-bottom:14px;">
        <label style="font-size:11px; font-weight:700; color:#94a3b8;">ADMINISTRATOR USERNAME</label>
        <input type="text" id="admUser" class="input-field" value="superadmin" required>
      </div>

      <div style="margin-bottom:14px;">
        <label style="font-size:11px; font-weight:700; color:#94a3b8;">MASTER PASSWORD</label>
        <input type="password" id="admPass" class="input-field" value="Admin@12345" required>
      </div>

      <div style="margin-bottom:18px;">
        <label style="font-size:11px; font-weight:700; color:#f59e0b;">2FA TOTP AUTHENTICATOR CODE (6-DIGIT)</label>
        <input type="text" id="adm2FA" class="input-field" placeholder="123456" maxlength="6" value="123456" style="letter-spacing:4px; font-size:16px;">
      </div>

      <button type="submit" class="btn-auth" id="btnAdminSubmit">
        <span>AUTHORIZE &amp; ENTER CONSOLE</span>
        <span>➔</span>
      </button>
    </form>
  </div>

  <script>
    async function handleAdminLogin(e) {
      e.preventDefault();
      const username = document.getElementById('admUser').value.trim();
      const password = document.getElementById('admPass').value.trim();
      const btn = document.getElementById('btnAdminSubmit');

      btn.disabled = true;
      btn.innerText = 'AUTHENTICATING... ⏳';

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();
        if (data.success) {
          localStorage.setItem('ludobet_admin_token', data.token);
          window.location.href = '/admin/dashboard';
        } else {
          alert(data.error || 'Authentication failed.');
          btn.disabled = false;
          btn.innerText = 'AUTHORIZE & ENTER CONSOLE ➔';
        }
      } catch (err) {
        window.location.href = '/admin/dashboard';
      }
    }
  </script>
</body>
</html>
