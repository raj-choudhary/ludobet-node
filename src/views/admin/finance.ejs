<div style="background:#0f172a; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:24px; margin-bottom:24px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <div>
      <h3 style="font-size:18px; font-weight:800;">Real User Bank Escrow vs House Bot Profit Matrix</h3>
      <span style="font-size:12px; color:#94a3b8;">Double-entry segregation between Real Player Liability and Virtual Bot GGR</span>
    </div>
    <span style="background:rgba(16,185,129,0.15); color:#10b981; border:1px solid rgba(16,185,129,0.3); padding:4px 12px; border-radius:8px; font-size:11px; font-weight:800;">
      RECONCILED TO ₹0.00
    </span>
  </div>

  <table style="width:100%; border-collapse:collapse; text-align:left; font-size:13px;">
    <thead>
      <tr style="border-bottom:1px solid rgba(255,255,255,0.1); color:#94a3b8;">
        <th style="padding:12px;">ACCOUNT CATEGORY</th>
        <th style="padding:12px;">TYPE</th>
        <th style="padding:12px;">TOTAL HELD / IMPACT</th>
        <th style="padding:12px;">BANK AUDIT STATUS</th>
      </tr>
    </thead>
    <tbody>
      <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
        <td style="padding:12px;"><strong style="color:#3b82f6;">Real User Deposit Balances</strong></td>
        <td style="padding:12px;">Bank Escrow Liability</td>
        <td style="padding:12px; font-weight:800;">₹<%= parseFloat(auditSummary.realUserEscrowLiability.total_real_deposits_held || 0).toFixed(2) %></td>
        <td style="padding:12px; color:#10b981;">● 100% Backed by Bank Reserve</td>
      </tr>
      <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
        <td style="padding:12px;"><strong style="color:#3b82f6;">Real User Winning Balances</strong></td>
        <td style="padding:12px;">Bank Escrow Liability</td>
        <td style="padding:12px; font-weight:800;">₹<%= parseFloat(auditSummary.realUserEscrowLiability.total_real_winnings_held || 0).toFixed(2) %></td>
        <td style="padding:12px; color:#10b981;">● Instant Withdrawable Liability</td>
      </tr>
      <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
        <td style="padding:12px;"><strong style="color:#10b981;">Organic 1v1 P2P Rake (5%)</strong></td>
        <td style="padding:12px;">House Operational Income</td>
        <td style="padding:12px; font-weight:800; color:#10b981;">₹<%= parseFloat(auditSummary.p2pOrganicRakeRevenue || 0).toFixed(2) %></td>
        <td style="padding:12px; color:#10b981;">● Real Net Realized Revenue</td>
      </tr>
      <tr>
        <td style="padding:12px;"><strong style="color:#f59e0b;">Stealth Bot Net Profit (GGR)</strong></td>
        <td style="padding:12px;">House Bot Margin</td>
        <td style="padding:12px; font-weight:800; color:#f59e0b;">₹<%= parseFloat(auditSummary.houseBotAccounting.houseBotNetProfit || 0).toFixed(2) %></td>
        <td style="padding:12px; color:#f59e0b;">● Shadow Accounting Segregated</td>
      </tr>
    </tbody>
  </table>
</div>
