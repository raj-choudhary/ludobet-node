<div class="admin-data-panel">
  <div class="data-panel-top-bar">
    <div>
      <h1 class="page-title-main">Financial Ledger &amp; Transactions</h1>
      <p class="page-title-sub">Real-time ACID transaction history and escrow audit trail.</p>
    </div>
  </div>

  <div class="admin-table-frame">
    <table class="admin-data-table">
      <thead>
        <tr>
          <th>Txn ID</th>
          <th>Player Name</th>
          <th>Type</th>
          <th>Amount</th>
          <th>Closing Balance</th>
          <th>Status</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% if (transactions && transactions.length > 0) { %>
          <% transactions.forEach(function(t) { %>
            <tr>
              <td><strong><%= t.transaction_code %></strong></td>
              <td><%= t.user_name %></td>
              <td><span class="badge-role"><%= t.type %></span></td>
              <td>
                <strong style="color:<%= t.type.includes('DEPOSIT') || t.type.includes('WIN') ? '#059669' : '#dc2626' %>">
                  <%= t.type.includes('DEPOSIT') || t.type.includes('WIN') ? '+' : '-' %>₹<%= parseFloat(t.amount).toFixed(2) %>
                </strong>
              </td>
              <td>₹<%= parseFloat(t.closing_balance).toFixed(2) %></td>
              <td>
                <span class="status-tag <%= t.status === 'SUCCESS' ? 'verified' : 'pending' %>">
                  <%= t.status %>
                </span>
              </td>
              <td><%= new Date(t.created_at).toLocaleString('en-IN') %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align:center; padding:20px; color:#94a3b8;">No transactions recorded yet.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
