        </a>
        <a class="btn-table-action" href="kyc-history.html" style="text-decoration:none; padding:8px 16px; font-weight:800; background:#6366f1; color:#ffffff;">
          📜 Completed Verification History (1,24,142)
        </a>
      </div>

      <!-- History Summary Metrics -->
      <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:14px;">
        <div class="kpi-stat-card">
          <span class="kpi-label-text">TOTAL VERIFIED ALL-TIME</span>
          <div class="kpi-amount-val" style="color:#10b981;">1,24,124</div>
          <span style="font-size:10px; color:#10b981;">● 98.6% Approved</span>
        </div>
        <div class="kpi-stat-card">
          <span class="kpi-label-text">REJECTED / SUSPICIOUS</span>
          <div class="kpi-amount-val" style="color:#ef4444;">1,812</div>
          <span style="font-size:10px; color:#ef4444;">● 1.4% Rejection Rate</span>
        </div>
        <div class="kpi-stat-card">
          <span class="kpi-label-text">REVOKED FOR FRAUD</span>
          <div class="kpi-amount-val" style="color:#f59e0b;">42</div>
          <span style="font-size:10px; color:#f59e0b;">Post-verification Penalties</span>
        </div>
        <div class="kpi-stat-card">
          <span class="kpi-label-text">PROCESSED TODAY</span>
          <div class="kpi-amount-val" style="color:#6366f1;">842</div>
          <span style="font-size:10px; color:#10b981;">↑ 14% vs yesterday</span>
        </div>
      </div>

      <!-- Main History Ledger Table Panel -->
      <div class="admin-data-panel">
        <div class="data-panel-top-bar">
          <div>
            <h1 class="page-title-main">KYC Action History Records</h1>
            <p class="page-title-sub">Immutable audit trail of all approved, rejected, and modified player verification requests.</p>
          </div>

          <!-- Search & Filter Controls -->
          <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
            <div class="data-search-input-box">
              <span>🔍</span>
              <input type="text" class="data-search-field" id="kyc-history-search" placeholder="Search by Player ID, Name, Admin, Doc No..." oninput="renderKYCHistoryTable(this.value)">
            </div>

            <!-- Filter Chips -->
            <div class="filter-chips-row" id="kyc-history-chips">
              <button class="filter-chip-btn active" onclick="filterKYCHistory(this, 'all')">ALL (6)</button>
              <button class="filter-chip-btn" onclick="filterKYCHistory(this, 'approved')">APPROVED (4)</button>
              <button class="filter-chip-btn" onclick="filterKYCHistory(this, 'rejected')">REJECTED (2)</button>
            </div>
          </div>
        </div>

        <div class="admin-table-frame">
          <table class="admin-data-table">
            <thead>
              <tr>
                <th>Verification ID</th>
                <th>Player ID &amp; Name</th>
                <th>Document Details</th>
                <th>Action Verdict</th>
                <th>Reviewed By</th>
                <th>Mandatory Rationale / Reason</th>
                <th>Timestamp</th>
                <th>IP Address</th>
                <th>Snapshot</th>
              </tr>
            </thead>
            <tbody id="kyc-history-table-body">
              <!-- Dynamically populated via admin.js -->
            </tbody>
          </table>
        </div>
      </div>
