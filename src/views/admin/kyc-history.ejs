  <!-- KYC VERIFIED DOCUMENT SNAPSHOT VIEWER MODAL -->
  <div class="admin-modal-overlay" id="modal-kyc-snapshot-viewer">
    <div class="admin-modal-window large">
      <div class="admin-modal-header">
        <span class="admin-modal-title">🪪 Verified KYC Document Audit Snapshot</span>
        <button class="admin-modal-close-btn" onclick="closeKYCSnapshotModal()">✕</button>
      </div>
      <div class="admin-modal-body">
        <!-- Meta Row -->
        <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:12px; font-size:11.5px;">
          <div>
            <span style="font-size:10px; font-weight:800; color:#64748b; text-transform:uppercase;">Audit ID</span>
            <div style="font-weight:900; color:#0f172a;" id="kyc-snap-id">KYC-VER-89421</div>
          </div>
          <div>
            <span style="font-size:10px; font-weight:800; color:#64748b; text-transform:uppercase;">Player Info</span>
            <div style="font-weight:800; color:#0f172a;" id="kyc-snap-player">Rajendra (LD10458)</div>
          </div>
          <div>
            <span style="font-size:10px; font-weight:800; color:#64748b; text-transform:uppercase;">Verdict</span>
            <div id="kyc-snap-verdict"><span class="status-pill-badge approved">APPROVED ✅</span></div>
          </div>
          <div>
            <span style="font-size:10px; font-weight:800; color:#64748b; text-transform:uppercase;">Reviewed By</span>
            <div style="font-weight:800; color:#6366f1;" id="kyc-snap-admin">Kavita Singh (KYC Exec)</div>
          </div>
        </div>

        <!-- High-Res Simulated Document Card -->
        <div class="doc-snapshot-card">
          <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.15); padding-bottom:12px; margin-bottom:14px;">
            <div style="display:flex; align-items:center; gap:10px;">
              <span style="font-size:24px;">🏛️</span>
              <div>
                <div style="font-size:12px; font-weight:900; letter-spacing:1px;" id="kyc-snap-doctype">GOVERNMENT OF INDIA • AADHAAR CARD</div>
                <div style="font-size:10px; color:#94a3b8;">Unique Identification Authority of India</div>
              </div>
            </div>
            <div style="background:rgba(16, 185, 129, 0.2); border:1px solid #10b981; color:#34d399; font-size:10.5px; font-weight:800; padding:4px 10px; border-radius:6px;">
              VERIFIED &amp; TAMPER TESTED
            </div>
          </div>

          <div style="display:flex; gap:20px; align-items:center;">
            <div style="width:90px; height:110px; background:#334155; border:2px dashed rgba(255,255,255,0.3); border-radius:8px; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#94a3b8; font-size:10px; text-align:center; padding:4px;">
              <span style="font-size:32px;">👤</span>
              <span>Photo ID</span>
            </div>
            <div style="flex:1; display:flex; flex-direction:column; gap:8px;">
              <div>
                <span style="font-size:10px; color:#94a3b8; text-transform:uppercase;">Document Number</span>
                <div style="font-size:18px; font-weight:900; font-family:monospace; color:#38bdf8; letter-spacing:2px;" id="kyc-snap-docnum">XXXX-XXXX-8921</div>
              </div>
              <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; font-size:11px;">
                <div>
                  <span style="color:#94a3b8;">Verified Timestamp:</span>
                  <div style="font-weight:700;" id="kyc-snap-time">18 Aug 2026, 14:15</div>
                </div>
                <div>
                  <span style="color:#94a3b8;">Reviewer IP:</span>
                  <div style="font-weight:700;" id="kyc-snap-ip">192.168.1.10</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Mandatory Rationale -->
        <div class="form-group-item">
          <label class="form-label-text">Reviewer Audit Rationale &amp; Notes</label>
          <div style="background:#f1f5f9; border-left:4px solid #6366f1; border-radius:6px; padding:10px 14px; font-size:12px; font-style:italic; color:#334155;" id="kyc-snap-reason">
            "Govt UID matched &amp; clear scan verified"
          </div>
        </div>

        <!-- Actions -->
        <div class="admin-modal-footer" style="padding:0; background:transparent; border:none; margin-top:6px;">
          <button type="button" class="btn-table-action" onclick="closeKYCSnapshotModal()">Close Snapshot</button>
          <button type="button" class="btn-table-action" style="background:#6366f1; color:#fff;" onclick="showToast('Exporting cryptographic verification certificate...', '📜')">
            🖨️ Export Audit Certificate
          </button>
        </div>
      </div>
    </div>
  </div>

