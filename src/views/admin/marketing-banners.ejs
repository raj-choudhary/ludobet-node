      <div class="header-right-group">
        <button class="header-icon-btn">🔍</button>
        <button class="header-icon-btn">🔔</button>
        <div class="admin-user-pill">
          <div class="admin-avatar-circle"><span>👨‍💼</span></div>
          <div class="admin-user-info">
            <span class="admin-user-name">Super Admin</span>
            <span class="admin-user-role">Super Administrator</span>
          </div>
        </div>
      </div>
    </header>

    <main class="admin-body-container">
      
      <!-- Subnav Navigation Pill Strip -->
      <div class="player-drawer-tabs-bar" style="background:#ffffff; border:1px solid var(--border-color); border-radius:14px; padding:4px 14px;">
        <a class="player-drawer-tab-btn active" href="marketing-banners.html" style="text-decoration:none;">🖼️ Home Banners</a>
        <a class="player-drawer-tab-btn" href="marketing-notifications.html" style="text-decoration:none;">🔔 Push Broadcaster</a>
      </div>

      <div class="admin-data-panel">
        <div class="data-panel-top-bar">
          <div>
            <h1 class="page-title-main">Active Homepage Carousel Slides</h1>
            <p class="page-title-sub">Upload promotional posters, configure deep-links (Tournaments, Wallet, Spin), and set display priority.</p>
          </div>
          <div>
            <button class="btn-table-action" style="background:#6366f1; color:#fff; padding:8px 16px; font-weight:800;" onclick="openAddBannerModal()">
              ➕ UPLOAD NEW BANNER
            </button>
          </div>
        </div>

        <div class="admin-table-frame" style="margin-top:14px;">
          <table class="admin-data-table">
            <thead>
              <tr>
                <th>Priority</th>
                <th>Banner Title</th>
                <th>Target Action (Deep Link)</th>
                <th>Schedule Window</th>
                <th>Clicks Tracked</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="banners-table-body">
              <!-- Dynamically populated via admin.js -->
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <!-- BANNER CREATE / EDIT MODAL -->
  <div class="admin-modal-overlay" id="modal-banner-form">
    <div class="admin-modal-window">
      <div class="admin-modal-header">
        <span class="admin-modal-title" id="banner-form-modal-title">➕ Upload &amp; Configure New Banner</span>
        <button class="admin-modal-close-btn" onclick="closeBannerModal()">✕</button>
      </div>
      <form onsubmit="saveBannerForm(event)" class="admin-modal-body">
        <input type="hidden" id="banner-edit-id">
        <div class="form-group-item">
          <label class="form-label-text">Banner Title / Campaign Tagline</label>
          <input type="text" class="form-control-input" id="banner-title-input" placeholder="e.g. ₹50,000 Weekend Mega Tournament" required>
        </div>
        <div class="form-group-item">
          <label class="form-label-text">Target In-App Deep Link Action</label>
          <select class="form-control-select" id="banner-action-input">
            <option value="openTournament(T-100K)">🏆 Open Tournament Registration: openTournament(T-100K)</option>
            <option value="openWalletAddCash(500)">💰 Open Wallet Add Cash: openWalletAddCash(500)</option>
            <option value="openGame('classic')">🎲 Launch Game Mode: openGame('classic')</option>
            <option value="openGame('quick')">⚡ Launch Game Mode: openGame('quick')</option>
            <option value="openSpin()">🎡 Launch Daily Spin Wheel: openSpin()</option>
            <option value="openReferrals()">🤝 Open Refer &amp; Earn: openReferrals()</option>
          </select>
        </div>
        <div class="form-group-item">
          <label class="form-label-text">Display Priority (Position 1, 2, 3...)</label>
          <input type="number" class="form-control-input" id="banner-priority-input" min="1" max="10" value="1" required>
        </div>
        <div class="form-group-item">
          <label class="form-label-text">Schedule Duration Window</label>
          <input type="text" class="form-control-input" id="banner-schedule-input" value="Always Active" placeholder="e.g. 25 Aug - 31 Aug 2026">
        </div>
        <div class="admin-modal-footer" style="padding:0; background:transparent; border:none; margin-top:10px;">
          <button type="button" class="btn-table-action" onclick="closeBannerModal()">Cancel</button>
          <button type="submit" class="btn-table-action" style="background:#6366f1; color:#fff; padding:8px 18px; font-weight:800;">
            💾 Publish Banner
          </button>
        </div>
      </form>
    </div>
  </div>

