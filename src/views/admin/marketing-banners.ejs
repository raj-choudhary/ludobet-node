  <!-- MAIN WRAPPER -->
  <div class="admin-main-wrapper">
    <header class="admin-top-header">
      <div class="header-left-group">
        <button class="btn-sidebar-toggle" onclick="toggleMobileSidebar()">☰</button>
        <h2 style="font-size:16px; font-weight:800; color:#0f172a;">🖼️ Home Carousel Banners CMS</h2>
