  <script src="admin.js"></script>
  <script>
    function injectQuickBattle() {
      const fee = document.getElementById('quickBetAmount').value;
      const persona = document.getElementById('quickBotPersona').value;
      const prize = Math.floor(fee * 2 * 0.94);

      const tbody = document.getElementById('quickBattlesBody');
      const tr = document.createElement('tr');
      tr.setAttribute('data-type', 'bot');
      tr.style.background = '#f0f9ff';
      tr.innerHTML = `
        <td><code>BTL-QK-${Math.floor(1000 + Math.random() * 9000)}</code></td>
        <td><span class="quick-badge">⚡ QUICK BOT CONTEST</span></td>
        <td><strong>${persona}</strong> <small style="color:#2563eb;">(Bot)</small></td>
        <td><span style="color:#64748b;">⏳ Waiting in Lobby...</span></td>
        <td><strong style="color:#0f172a;">₹${fee}.00</strong></td>
        <td><strong style="color:#10b981;">₹${prize}.00</strong></td>
        <td><span class="status-pill-badge approved">OPEN CONTEST</span></td>
        <td>
          <button class="btn-table-action danger" style="font-size:10.5px;" onclick="this.closest('tr').remove(); showToast('Quick contest removed from lobby', '🗑️')">REMOVE</button>
        </td>
      `;
      tbody.prepend(tr);
      showToast(`Quick Contest ₹${fee} by '${persona}' deployed to lobby!`, '🚀');
    }

    function filterQuickTable(type) {
      const rows = document.querySelectorAll('#quickBattlesBody tr');
      rows.forEach(r => {
        if (type === 'all') r.style.display = '';
        else if (r.getAttribute('data-type') === type) r.style.display = '';
        else r.style.display = 'none';
      });
      showToast(`Filtered by ${type.toUpperCase()}`, '🔍');
    }
  </script>
