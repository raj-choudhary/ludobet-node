  <!-- DISPUTE EVIDENCE SIDE-BY-SIDE VIEWER MODAL -->
  <div class="admin-audit-modal" id="modal-dispute-viewer">
    <div class="audit-modal-box" style="max-width:600px;">
      <h3 style="font-size:16px; font-weight:900; color:#b91c1c;">⚖️ Dispute Verdict Console</h3>
      <p style="font-size:11.5px; color:#64748b;" id="disp-modal-battle">Battle #BTL-94821 (Ludo Classic - ₹95 Pool)</p>

      <div class="split-evidence-grid" style="margin-top:14px;">
        <div class="evidence-box-card">
          <strong style="color:#0288d1; font-size:12px;">Player A: Rajendra</strong>
          <div class="evidence-screenshot-img" style="display:flex; align-items:center; justify-content:center; color:#4ade80;">
            🏆 [Winning Screenshot Attached]
          </div>
          <p style="font-size:10.5px; color:#475569;">"Won all 4 gotis home. Score 56."</p>
        </div>

        <div class="evidence-box-card">
          <strong style="color:#f59e0b; font-size:12px;">Player B: Amit</strong>
          <div class="evidence-screenshot-img" style="display:flex; align-items:center; justify-content:center; color:#f87171;">
            ❌ [Blurry Screenshot]
          </div>
          <p style="font-size:10.5px; color:#475569;">"Opponent disconnected."</p>
        </div>
      </div>

      <!-- Binding Verdict Actions -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:16px;">
        <button class="btn-table-action" style="background:#10b981; color:#fff; padding:10px 0;" onclick="resolveDisputeVerdict('Player A Wins (+₹95)')">
          PLAYER A WINS 🏆
        </button>
        <button class="btn-table-action" style="background:#3b82f6; color:#fff; padding:10px 0;" onclick="resolveDisputeVerdict('Player B Wins (+₹95)')">
          PLAYER B WINS 🏆
        </button>
        <button class="btn-table-action" style="background:#fef3c7; color:#b45309; padding:10px 0;" onclick="resolveDisputeVerdict('Cancel &amp; Refund ₹50 to Both')">
          CANCEL &amp; REFUND BOTH 🤝
        </button>
        <button class="btn-table-action danger" style="padding:10px 0;" onclick="resolveDisputeVerdict('Cheater Penalized &amp; Banned')">
          BAN CHEATER 🚫
        </button>
      </div>
    </div>
  </div>

