            <span class="admin-user-role">Super Administrator</span>
          </div>
        </div>
      </div>
    </header>

    <main class="admin-body-container">
      
      <!-- Dispute Summary Cards -->
      <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:14px;">
        <div class="kpi-stat-card">
          <span class="kpi-label-text">OPEN DISPUTE CASES</span>
          <div class="kpi-amount-val" style="color:#ef4444;">7 Cases</div>
          <span style="font-size:10px; color:#ef4444;">● Requires Admin Review</span>
        </div>
        <div class="kpi-stat-card">
          <span class="kpi-label-text">RESOLVED TODAY</span>
          <div class="kpi-amount-val" style="color:#10b981;">34 Cases</div>
          <span style="font-size:10px; color:#10b981;">● 94% Solved within SLA</span>
        </div>
        <div class="kpi-stat-card">
          <span class="kpi-label-text">AVERAGE RESOLUTION TIME</span>
          <div class="kpi-amount-val" style="color:#6366f1;">8.5 Mins</div>
          <span style="font-size:10px; color:#64748b;">Target SLA: 15 Mins</span>
        </div>
        <div class="kpi-stat-card">
          <span class="kpi-label-text">CHEATING BANS ISSUED</span>
          <div class="kpi-amount-val" style="color:#0f172a;">3 Today</div>
          <span style="font-size:10px; color:#ef4444;">Fake Screenshot Penalties</span>
        </div>
      </div>

      <div class="admin-data-panel">
        <div class="data-panel-top-bar">
          <div>
            <h1 class="page-title-main">Dispute Moderation Queue</h1>
            <p class="page-title-sub">Inspect side-by-side player screenshots and deliver binding fairplay verdicts.</p>
          </div>
        </div>

        <div class="admin-table-frame">
          <table class="admin-data-table">
            <thead>
              <tr>
                <th>Dispute ID</th>
                <th>Battle &amp; Game</th>
                <th>Player A (Claim)</th>
                <th>Player B (Claim)</th>
                <th>Prize Pool</th>
                <th>Status</th>
                <th>Evidence Review</th>
              </tr>
            </thead>
            <tbody id="disputes-table-body">
              <!-- Dynamically populated via admin.js -->
            </tbody>
          </table>
        </div>
      </div>
    </main>
