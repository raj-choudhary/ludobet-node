      <!-- Grid Row 1: Game-wise Commission & Commission Tiers -->
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-bottom:20px;">
        
        <!-- Game-wise Default Commission -->
        <div class="admin-data-panel">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <h2 style="font-size:15px; font-weight:800; color:#0f172a;">🎮 Mode-wise Base Platform Rake (%)</h2>
            <span class="nav-pill-badge blue">Realtime Sync</span>
          </div>
          
          <div style="display:flex; flex-direction:column; gap:14px;">
            <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 16px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px;">
              <div>
                <strong style="font-size:13px; color:#0f172a;">🎲 Ludo Classic Mode</strong>
                <p style="font-size:11px; color:#64748b; margin:2px 0 0;">Standard 4-token complete board game.</p>
              </div>
              <div style="display:flex; align-items:center; gap:6px; width:120px;">
                <input type="number" id="rakeClassic" value="5.0" step="0.5" min="0" max="25" class="form-control-input" style="text-align:center; font-weight:900; color:#6366f1;">
                <span style="font-size:14px; font-weight:900; color:#64748b;">%</span>
              </div>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 16px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px;">
              <div>
                <strong style="font-size:13px; color:#0f172a;">⚡ Ludo Quick Mode (1-Token)</strong>
                <p style="font-size:11px; color:#64748b; margin:2px 0 0;">High frequency rapid 1-token reach battle.</p>
              </div>
              <div style="display:flex; align-items:center; gap:6px; width:120px;">
                <input type="number" id="rakeQuick" value="6.0" step="0.5" min="0" max="25" class="form-control-input" style="text-align:center; font-weight:900; color:#6366f1;">
                <span style="font-size:14px; font-weight:900; color:#64748b;">%</span>
              </div>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 16px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px;">
              <div>
                <strong style="font-size:13px; color:#0f172a;">🪜 Snake &amp; Ladders Mode</strong>
                <p style="font-size:11px; color:#64748b; margin:2px 0 0;">Casual roll-to-100 turn based match.</p>
              </div>
              <div style="display:flex; align-items:center; gap:6px; width:120px;">
                <input type="number" id="rakeSnake" value="5.0" step="0.5" min="0" max="25" class="form-control-input" style="text-align:center; font-weight:900; color:#6366f1;">
                <span style="font-size:14px; font-weight:900; color:#64748b;">%</span>
              </div>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 16px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px;">
              <div>
                <strong style="font-size:13px; color:#0f172a;">🏆 Mega Tournament Pool Rake</strong>
                <p style="font-size:11px; color:#64748b; margin:2px 0 0;">Deducted from entry pool before prize distribution.</p>
              </div>
              <div style="display:flex; align-items:center; gap:6px; width:120px;">
                <input type="number" id="rakeTourney" value="10.0" step="0.5" min="0" max="30" class="form-control-input" style="text-align:center; font-weight:900; color:#6366f1;">
                <span style="font-size:14px; font-weight:900; color:#64748b;">%</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Tiered Commission Engine -->
        <div class="admin-data-panel">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <div>
              <h2 style="font-size:15px; font-weight:800; color:#0f172a;">📊 Battle Amount Tiered Commission</h2>
              <p style="font-size:11px; color:#64748b; margin:2px 0 0;">Lower commission on high-stakes battles to incentivize big deposits.</p>
            </div>
            <button class="btn-table-action" style="background:#10b981; color:#fff; font-size:11px;" onclick="addCommissionTier()">+ ADD TIER</button>
          </div>

          <div class="admin-table-container">
            <table class="admin-data-table">
              <thead>
