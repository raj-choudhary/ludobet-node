                <tr>
                  <td><span class="nav-pill-badge blue">Tier 1 (Micro)</span></td>
                  <td><strong>₹10 — ₹200</strong></td>
                  <td><strong style="color:#6366f1;">5.0%</strong></td>
                  <td><button class="btn-table-action" style="color:#ef4444;" onclick="showToast('Default tier cannot be deleted', '⚠️')">🔒 Default</button></td>
                </tr>
                <tr>
                  <td><span class="nav-pill-badge yellow">Tier 2 (Mid-Roller)</span></td>
                  <td><strong>₹201 — ₹1,000</strong></td>
                  <td><strong style="color:#6366f1;">4.5%</strong></td>
                  <td><button class="btn-table-action" style="color:#ef4444;" onclick="this.closest('tr').remove(); showToast('Tier removed', '🗑️')">Delete</button></td>
                </tr>
                <tr>
                  <td><span class="nav-pill-badge green">Tier 3 (High-Roller)</span></td>
                  <td><strong>₹1,001 — ₹10,000+</strong></td>
                  <td><strong style="color:#6366f1;">3.5%</strong></td>
                  <td><button class="btn-table-action" style="color:#ef4444;" onclick="this.closest('tr').remove(); showToast('Tier removed', '🗑️')">Delete</button></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- Grid Row 2: Deposit & Withdrawal Limits + Instant Auto Payout -->
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-bottom:20px;">
        
        <!-- Deposit & Withdrawal Constraints -->
        <div class="admin-data-panel">
          <h2 style="font-size:15px; font-weight:800; color:#0f172a; margin-bottom:16px;">💳 Wallet Cash Limits &amp; Caps</h2>
          
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px;">
            <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:12px;">
              <label style="font-size:11.5px; font-weight:700; color:#475569; display:block; margin-bottom:6px;">Min Deposit Allowed</label>
              <div style="display:flex; align-items:center; gap:6px;">
                <span style="font-weight:900; color:#10b981;">₹</span>
                <input type="number" id="minDeposit" value="10" class="form-control-input" style="font-weight:800;">
              </div>
            </div>

            <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:12px;">
              <label style="font-size:11.5px; font-weight:700; color:#475569; display:block; margin-bottom:6px;">Max Single Deposit</label>
              <div style="display:flex; align-items:center; gap:6px;">
                <span style="font-weight:900; color:#10b981;">₹</span>
                <input type="number" id="maxDeposit" value="50000" class="form-control-input" style="font-weight:800;">
              </div>
            </div>

            <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:12px;">
              <label style="font-size:11.5px; font-weight:700; color:#475569; display:block; margin-bottom:6px;">Min Withdrawal Allowed</label>
              <div style="display:flex; align-items:center; gap:6px;">
                <span style="font-weight:900; color:#10b981;">₹</span>
                <input type="number" id="minWithdrawal" value="100" class="form-control-input" style="font-weight:800;">
              </div>
            </div>

            <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:12px;">
              <label style="font-size:11.5px; font-weight:700; color:#475569; display:block; margin-bottom:6px;">Daily Max Payout Cap</label>
              <div style="display:flex; align-items:center; gap:6px;">
                <span style="font-weight:900; color:#10b981;">₹</span>
                <input type="number" id="maxDailyWithdrawal" value="50000" class="form-control-input" style="font-weight:800;">
              </div>
            </div>
          </div>

          <div style="background:#eff6ff; border:1px dashed #3b82f6; border-radius:10px; padding:10px 14px; font-size:11.5px; color:#1e40af;">
            ℹ️ Players can make up to <strong>3 withdrawals per 24 hours</strong>. Payouts exceeding ₹50,000 require manual Super Admin 2-step review.
          </div>
        </div>

        <!-- Automated Payout IMPS Engine -->
        <div class="admin-data-panel">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <h2 style="font-size:15px; font-weight:800; color:#0f172a;">⚡ Instant Automated Payout Engine</h2>
            <input type="checkbox" id="autoPayoutEnabled" checked style="width:20px; height:20px; cursor:pointer;">
          </div>
          
          <p style="font-size:12px; color:#64748b; margin-bottom:14px;">
            When enabled, verified KYC players' withdrawal requests below the automated threshold are disbursed instantly via Cashfree/RazorpayX IMPS without admin queue waiting.
          </p>

          <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:12px; padding:14px; margin-bottom:14px;">
            <label style="font-size:12px; font-weight:800; color:#0f172a; display:block; margin-bottom:6px;">Instant Auto-Approval Threshold Ceiling (₹)</label>
            <div style="display:flex; align-items:center; gap:8px;">
              <span style="font-size:16px; font-weight:900; color:#10b981;">₹</span>
              <input type="number" id="autoPayoutLimit" value="2000" class="form-control-input" style="font-size:14px; font-weight:900; color:#0f172a;">
            </div>
            <span style="font-size:10.5px; color:#64748b; margin-top:4px; display:block;">Any request &gt; ₹2,000 will be held in the Manual Payout Queue for security audit.</span>
          </div>

          <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:#fff7ed; border:1px solid #ffedd5; border-radius:10px;">
            <span style="font-size:11.5px; font-weight:700; color:#c2410c;">🔒 Require Full KYC Approval for Auto-Payout</span>
            <input type="checkbox" checked style="width:18px; height:18px; cursor:pointer;">
          </div>
        </div>

