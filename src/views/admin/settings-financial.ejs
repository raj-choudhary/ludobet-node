  <script src="admin.js"></script>
  <script>
    function addCommissionTier() {
      const min = prompt("Enter Minimum Battle Amount (₹):", "2000");
      if (!min) return;
      const max = prompt("Enter Maximum Battle Amount (₹):", "5000");
      if (!max) return;
      const pct = prompt("Enter Commission Percentage (%):", "3.0");
      if (!pct) return;

      const tbody = document.getElementById('tierTableBody');
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><span class="nav-pill-badge blue">Custom Tier</span></td>
        <td><strong>₹${Number(min).toLocaleString('en-IN')} — ₹${Number(max).toLocaleString('en-IN')}</strong></td>
        <td><strong style="color:#6366f1;">${pct}%</strong></td>
        <td><button class="btn-table-action" style="color:#ef4444;" onclick="this.closest('tr').remove(); showToast('Tier removed', '🗑️')">Delete</button></td>
      `;
      tbody.appendChild(tr);
      showToast('New Commission Tier Added!', '✅');
    }

    function saveFinancialSettings() {
      const classic = document.getElementById('rakeClassic').value;
      const quick = document.getElementById('rakeQuick').value;
      const snake = document.getElementById('rakeSnake').value;
      const autoLimit = document.getElementById('autoPayoutLimit').value;

      if (window.STATE && window.STATE.auditLogs) {
        window.STATE.auditLogs.unshift({
          action: "UPDATED_FINANCIAL_PARAMETERS",
          actor: "Super Admin (You)",
          time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
          details: `Updated Platform Commission: Classic ${classic}%, Quick ${quick}%, Snake ${snake}%. Auto Payout Limit: ₹${autoLimit}`,
          ip: "103.241.12.89"
        });
      }

      showToast('Financial parameters & commission tiers updated & cached!', '💾');
    }

    function resetFinancialSettings() {
      if (confirm("Are you sure you want to reset all financial parameters to factory defaults?")) {
        document.getElementById('rakeClassic').value = "5.0";
        document.getElementById('rakeQuick').value = "6.0";
        document.getElementById('rakeSnake').value = "5.0";
        document.getElementById('rakeTourney').value = "10.0";
        document.getElementById('minDeposit').value = "10";
        document.getElementById('maxDeposit').value = "50000";
        document.getElementById('minWithdrawal').value = "100";
        document.getElementById('maxDailyWithdrawal').value = "50000";
        document.getElementById('autoPayoutLimit').value = "2000";
        showToast('Restored default financial settings', '↺');
      }
    }
  </script>
</body>
