      <!-- Grid Row 3: Tax Compliance (30% Govt TDS & GST) & Official Contacts -->
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px;">
        
        <!-- Tax Compliance (Govt TDS & GST) -->
        <div class="admin-data-panel">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <h2 style="font-size:15px; font-weight:800; color:#0f172a;">🏛️ Govt Tax &amp; TDS Compliance (Sec 194BA)</h2>
            <span class="nav-pill-badge red">Legal Mandatory</span>
          </div>
          
          <div style="display:flex; flex-direction:column; gap:12px;">
            <div style="display:flex; justify-content:space-between; align-items:center; padding:12px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px;">
              <div>
                <strong style="font-size:12px; color:#0f172a;">30% TDS on Net Winnings at Withdrawal</strong>
                <p style="font-size:10.5px; color:#64748b; margin:2px 0 0;">Deduct 30% tax on net profit (Withdrawal - Total Deposits).</p>
              </div>
              <input type="checkbox" id="tdsEnabled" checked style="width:18px; height:18px; cursor:pointer;">
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; padding:12px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px;">
              <div>
                <strong style="font-size:12px; color:#0f172a;">Annual TDS Threshold Limit (₹)</strong>
                <p style="font-size:10.5px; color:#64748b; margin:2px 0 0;">Under Indian Finance Act, Net Winnings threshold.</p>
              </div>
              <div style="width:110px;">
                <input type="number" id="tdsThreshold" value="0" class="form-control-input" style="text-align:center; font-weight:800;">
              </div>
            </div>

