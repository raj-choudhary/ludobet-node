  <script>
    function switchPGTab(tabKey, btn) {
      document.querySelectorAll('.pg-tab-content').forEach(el => el.style.display = 'none');
      document.querySelectorAll('.pg-tab-btn').forEach(el => el.classList.remove('active'));
      document.getElementById(`tab-${tabKey}`).style.display = 'block';
      btn.classList.add('active');
    }

    function toggleKeyVisibility(id, btn) {
      const input = document.getElementById(id);
      if (input.type === 'password') {
        input.type = 'text';
        btn.innerText = '🙈';
      } else {
        input.type = 'password';
        btn.innerText = '👁️';
      }
    }

    function testGatewayPing(pgName) {
      showToast(`Pinging ${pgName} API endpoint...`, '⚡');
      setTimeout(() => {
        showToast(`✅ ${pgName} Handshake Success! 200 OK (Latency: 184ms)`, '🟢');
      }, 1000);
    }

    function saveAllGateways() {
      if (window.STATE && window.STATE.auditLogs) {
        window.STATE.auditLogs.unshift({
          action: "UPDATED_PAYMENT_GATEWAYS",
          actor: "Super Admin (You)",
          time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
          details: "Updated Payment Gateway API credentials, Manual UPI VPA, and Crypto TRC20/BEP20 settings.",
          ip: "103.241.12.89"
        });
      }
      showToast('All payment gateways and crypto configurations updated!', '💾');
    }
  </script>
