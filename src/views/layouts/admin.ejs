<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Ludo Bet — Super Admin Cockpit' %></title>
  <meta name="description" content="Enterprise Super Admin Dashboard & Role-Based Employee Control Suite for Ludo Bet.">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

  <!-- =========================================================================
       1. LEFT SIDEBAR NAVIGATION (ALL 17 MODULES)
       ========================================================================= -->
  <aside class="admin-sidebar" id="admin-sidebar">
    <!-- Brand Header -->
    <div class="sidebar-brand-header">
      <span class="brand-crown-icon">👑</span>
      <div class="brand-title-group">
        <span class="brand-main-title">LUDO BET</span>
        <span class="brand-super-tag" id="header-role-tag"><%= admin ? admin.role : 'SUPER ADMIN' %></span>
      </div>
    </div>

    <!-- Scrollable Navigation Menu -->
    <div class="sidebar-menu-scroll">
      
      <!-- 1. Dashboard -->
      <a class="nav-item-btn <%= activeMenu === 'dashboard' ? 'active' : '' %>" href="/admin/dashboard">
        <div class="nav-left-group">
          <span class="nav-item-icon">🏠</span>
          <span>Dashboard</span>
        </div>
      </a>

      <!-- 2. Players -->
      <a class="nav-item-btn <%= activeMenu === 'players' ? 'active' : '' %>" href="/admin/players">
        <div class="nav-left-group">
          <span class="nav-item-icon">👥</span>
          <span>Players</span>
        </div>
      </a>

      <!-- 3. Finance -->
      <a class="nav-item-btn <%= activeMenu === 'finance' ? 'active' : '' %>" href="/admin/finance">
        <div class="nav-left-group">
          <span class="nav-item-icon">💰</span>
          <span>Finance &amp; Ledger</span>
        </div>
      </a>

      <!-- 4. Battles & Lobby -->
      <a class="nav-item-btn" href="/admin/dashboard#ghost-injector">
        <div class="nav-left-group">
          <span class="nav-item-icon">⚔️</span>
          <span>Ghost 1v1 Battles</span>
        </div>
      </a>

      <!-- 5. Open Player App -->
      <a class="nav-item-btn" href="/" target="_blank">
        <div class="nav-left-group">
          <span class="nav-item-icon">📱</span>
          <span>Open Player App ↗</span>
        </div>
      </a>

      <!-- 6. Logout -->
      <a class="nav-item-btn" href="/admin/logout" style="margin-top:20px; color:#ef4444;">
        <div class="nav-left-group">
          <span class="nav-item-icon">🚪</span>
          <span>Logout</span>
        </div>
      </a>
    </div>

    <!-- Sidebar Bottom (Emergency Maintenance Mode Switch) -->
    <div class="sidebar-footer-card">
      <div class="maintenance-switch-row">
        <div class="maint-title-group">
          <span>🛡️</span>
          <span>Maintenance Mode</span>
        </div>
        <input type="checkbox" onchange="alert('Maintenance mode toggled.')" style="cursor:pointer; width:18px; height:18px;">
      </div>
    </div>
  </aside>

  <!-- =========================================================================
       2. MAIN CONTENT WRAPPER & TOP HEADER
       ========================================================================= -->
  <div class="admin-main-wrapper">
    
    <!-- Top Header Bar -->
    <header class="admin-top-header">
      <div class="header-left-group">
        <button class="btn-sidebar-toggle" onclick="document.getElementById('admin-sidebar').classList.toggle('open')">☰</button>
        <span class="page-title-badge">👑 <%= admin ? admin.username : 'superadmin' %> (<%= admin ? admin.role : 'SUPER_ADMIN' %>)</span>
      </div>

      <div class="header-right-group">
        <div class="status-indicator-pill live">
          <span class="live-dot"></span>
          <span>SYSTEM OPERATIONAL</span>
        </div>
        <a href="/admin/logout" class="btn-header-logout" style="text-decoration:none;">Logout</a>
      </div>
    </header>

    <!-- Page Body -->
    <div class="admin-content-body">
      <%- body %>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
</body>
</html>
