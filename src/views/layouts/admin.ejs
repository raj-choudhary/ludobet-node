<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Master Admin Cockpit — Ludo Bet' %></title>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    :root {
      --sidebar-width: 260px;
      --bg-dark: #090d16;
      --panel-dark: #0f172a;
      --border-dark: rgba(255, 255, 255, 0.08);
      --accent-gold: #f59e0b;
      --accent-emerald: #10b981;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
    body { background: var(--bg-dark); color: #ffffff; display: flex; min-height: 100vh; }
    .admin-sidebar {
      width: var(--sidebar-width);
      background: var(--panel-dark);
      border-right: 1px solid var(--border-dark);
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 100;
    }
    .admin-brand {
      padding: 20px;
      border-bottom: 1px solid var(--border-dark);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .admin-nav {
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }
    .adm-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: 10px;
      color: #94a3b8;
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
    }
    .adm-link:hover, .adm-link.active {
      background: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
    }
    .admin-content-wrap {
      margin-left: var(--sidebar-width);
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    .admin-topbar {
      padding: 14px 28px;
      background: var(--panel-dark);
      border-bottom: 1px solid var(--border-dark);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .admin-main-slot {
      padding: 28px;
      flex: 1;
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div class="admin-brand">
      <span style="font-size:24px;">👑</span>
      <div>
        <strong style="font-size:15px; color:#ffffff;">LUDO BET</strong>
        <span style="display:block; font-size:9.5px; color:#f59e0b; font-weight:800;">COMMAND CONSOLE</span>
      </div>
    </div>

    <nav class="admin-nav">
      <a href="/admin/dashboard" class="adm-link <%= activeNav === 'dashboard' ? 'active' : '' %>">
        <span>📊</span>
        <span>Dashboard</span>
      </a>
      <a href="/admin/finance" class="adm-link <%= activeNav === 'finance' ? 'active' : '' %>">
        <span>💰</span>
        <span>Financial Matrix</span>
      </a>
      <a href="/admin/players" class="adm-link <%= activeNav === 'players' ? 'active' : '' %>">
        <span>👥</span>
        <span>Player Control</span>
      </a>
      <a href="/" target="_blank" class="adm-link">
        <span>🌐</span>
        <span>Open Player App ↗</span>
      </a>
      <a href="/admin/login" class="adm-link" style="margin-top:auto; color:#ef4444;">
        <span>🔒</span>
        <span>Logout Session</span>
      </a>
    </nav>
  </aside>

  <!-- Content Wrap -->
  <div class="admin-content-wrap">
    <header class="admin-topbar">
      <div>
        <h2 style="font-size:16px; font-weight:800;"><%= title %></h2>
        <span style="font-size:11px; color:#94a3b8;">Logged in as: <strong style="color:#f59e0b;"><%= admin.username %> (<%= admin.role %>)</strong></span>
      </div>
      <span style="font-size:11px; background:rgba(16,185,129,0.15); color:#10b981; border:1px solid rgba(16,185,129,0.3); padding:4px 10px; border-radius:6px; font-weight:800;">● SYSTEM OPERATIONAL</span>
    </header>

    <main class="admin-main-slot">
      <%- body %>
    </main>
  </div>

</body>
</html>
